---
// A reminder that only renders in `npm run dev`. Production builds drop it entirely.
const dev = import.meta.env.DEV;
---

{
  dev && (
    <aside class="dev-note">
      <span class="mono tag">To add · dev only</span>
      <div>
        <slot />
      </div>
    </aside>
  )
}

<style>
  .dev-note {
    display: grid;
    gap: 0.4rem;
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--ink-3);
    border-radius: 10px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .tag {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
  }
</style>
