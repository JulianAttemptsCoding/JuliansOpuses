---
import SchoolEntry from './SchoolEntry.astro';
import { highSchool, college } from '../data/profile';

interface Props {
  /** Show every coursework list expanded (About page). The home page keeps them folded. */
  open?: boolean;
}
const { open = false } = Astro.props;
---

<div class="edu">
  <SchoolEntry entry={highSchool} open={open} />

  <section class="college">
    <header class="college-head">
      <h3>{college.heading}</h3>
      <span class="mono mode">{college.mode}</span>
    </header>
    <p class="summary">{college.summary}</p>
    <div class="schools">
      {college.schools.map((s) => <SchoolEntry entry={s} open={open} level={4} />)}
    </div>
  </section>
</div>

<style>
  .edu > :global(.school:first-child) {
    padding-top: 0;
  }
  .college {
    padding-top: 1.1rem;
  }
  .college-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  h3 {
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .mode {
    color: var(--ink-3);
  }
  .summary {
    margin-top: 0.3rem;
    color: var(--ink-2);
    font-size: 0.98rem;
  }
  /* The colleges sit one level in, under the shared summary. */
  .schools {
    margin-top: 0.9rem;
    padding-left: clamp(0.9rem, 2vw, 1.5rem);
    border-left: 1px solid var(--ink);
  }
  .schools > :global(.school:first-child) {
    padding-top: 0.2rem;
  }
  .schools > :global(.school:last-child) {
    padding-bottom: 0.2rem;
    border-bottom: 0;
  }
</style>
