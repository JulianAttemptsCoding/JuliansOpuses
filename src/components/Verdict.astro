---
import { VERDICTS, type Status } from '../data/verdicts';

interface Props {
  status: Status;
  /** Legend form: a button, so the explanation can be reached by keyboard or tap. */
  bare?: boolean;
}
const { status, bare = false } = Astro.props;
// The legend entries are buttons so the explanation is reachable by keyboard and touch.
// Elsewhere the chip sits inside a link or beside its own explanation, so it stays a span.
const Tag = bare ? 'button' : 'span';
---

<Tag class:list={['verdict', status, { bare }]} type={bare ? 'button' : undefined} data-verdict={status}>
  <svg class="glyph" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
    {status === 'holds' && <circle cx="6" cy="6" r="5" fill="currentColor" />}
    {
      status === 'open' && (
        <>
          <circle cx="6" cy="6" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M6 1.75a4.25 4.25 0 0 1 0 8.5z" fill="currentColor" />
        </>
      )
    }
    {
      status === 'prototype' && (
        <circle cx="6" cy="6" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5" />
      )
    }
    {
      status === 'shipped' && (
        <rect x="2.5" y="2.5" width="7" height="7" fill="currentColor" transform="rotate(45 6 6)" />
      )
    }
    {
      status === 'negative' && (
        <path
          d="M2.25 2.25l7.5 7.5M9.75 2.25l-7.5 7.5"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        />
      )
    }
  </svg>
  <span>{VERDICTS[status].label}</span>
  <span class="tip" role="tooltip">
    <span class="sr-only">: </span>{VERDICTS[status].meaning}
  </span>
</Tag>

<script>
  // Keep each explanation inside the viewport: nudge it sideways if it would spill out.
  const EDGE = 12;
  const verdicts = document.querySelectorAll<HTMLElement>('[data-verdict]');
  // Escape puts an open explanation away without moving the pointer or the focus. It
  // comes back the next time the label is pointed at or focused.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    verdicts.forEach((el) => {
      if (el.matches(':hover, :focus')) el.setAttribute('data-tip-off', '');
    });
  });
  verdicts.forEach((el) => {
    const tip = el.querySelector<HTMLElement>('.tip');
    if (!tip) return;
    const back = () => el.removeAttribute('data-tip-off');
    el.addEventListener('pointerleave', back);
    el.addEventListener('blur', back);
    const fit = () => {
      tip.style.setProperty('--shift', '0px');
      const r = tip.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      let shift = 0;
      if (r.right > vw - EDGE) shift = vw - EDGE - r.right;
      if (r.left + shift < EDGE) shift = EDGE - r.left;
      tip.style.setProperty('--shift', `${Math.round(shift)}px`);
    };
    el.addEventListener('pointerenter', fit);
    el.addEventListener('focus', fit);
  });
</script>

<style>
  /* A glyph and a word. No chip around it: the shape and the word are the whole signal. */
  .verdict {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    /* Tall enough to press: 24px with the line of text. */
    padding: 0.27em 0;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: var(--t-sm);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    cursor: help;
  }
  .glyph {
    flex: none;
    transition: transform 0.3s var(--ease);
  }
  .verdict:hover .glyph,
  .verdict:focus-visible .glyph {
    transform: scale(1.25);
  }
  /* The hue is an extra cue; the glyph shape and the label carry the state on their own. */
  .holds .glyph {
    color: var(--v-holds);
  }
  .open .glyph {
    color: var(--v-open);
  }
  .prototype .glyph {
    color: var(--v-prototype);
  }
  .shipped .glyph {
    color: var(--v-shipped);
  }
  .negative .glyph {
    color: var(--v-negative);
  }

  .tip {
    position: absolute;
    top: calc(100% + 9px);
    left: 0;
    z-index: 45;
    width: max-content;
    max-width: min(17rem, 78vw);
    padding: 0.55rem 0.75rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 8px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    text-align: left;
    text-transform: none;
    white-space: normal;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    translate: var(--shift, 0px) -4px;
    transition:
      opacity 0.18s,
      translate 0.18s var(--ease),
      visibility 0.18s;
  }
  /* The legend sits at the right of its row, so its explanations open leftward. A hidden
     box still counts toward the page's scroll width, and this keeps them inside it. */
  .bare .tip {
    left: auto;
    right: 0;
  }
  /* The gap between the label and its explanation counts as part of the explanation, so
     the pointer can move onto it without it closing. */
  .tip::before {
    content: '';
    position: absolute;
    inset: -10px 0 100% 0;
  }
  .verdict:hover .tip,
  .verdict:focus .tip {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: var(--shift, 0px) 0;
  }
  .verdict[data-tip-off] .tip {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
</style>
