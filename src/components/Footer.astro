---
import { site, contact } from '../data/site';
import { href } from '../lib/url';

interface Props {
  /** Show the large call to action above the base line. The contact page turns it off. */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const dev = import.meta.env.DEV;
const year = new Date().getFullYear();
// The button only promises a message form when one is actually connected.
const contactLabel = contact.accessKey || dev ? 'Send a message' : 'Ways to reach me';
---

<footer class:list={['site-footer', { slim: !cta }]}>
  <div class="wrap">
    {
      cta && (
        <>
          <p class="label">Contact</p>
          <h2 class="cta">
            <span class="cta-line">Get in touch.</span>
          </h2>

          <ul class="links">
            <li>
              <a class="pill primary" href={href('/contact/')} data-magnetic>
                {contactLabel}
                <span class="pill-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
            {site.linkedin && (
              <li>
                <a class="pill fill ext" href={site.linkedin} rel="noopener">LinkedIn</a>
              </li>
            )}
            <li>
              <a class="pill fill ext" href={site.github} rel="noopener">GitHub</a>
            </li>
            {site.resume ? (
              <li>
                <a class="pill fill" href={href(site.resume)}>
                  Résumé (PDF)
                </a>
              </li>
            ) : (
              dev && (
                <li>
                  <span class="placeholder">Résumé: not set</span>
                </li>
              )
            )}
          </ul>
          {dev && !site.resume && (
            <p class="dev-note mono">
              Dashed items are placeholders from src/data/site.ts and are hidden in the production build.
            </p>
          )}
        </>
      )
    }

    <div class="base">
      <span class="mono meta">
        <span>© {year} {site.name}</span>
        <span class="local">
          <span class="live-dot" aria-hidden="true"></span>
          Local time <span data-clock>in California</span>
        </span>
      </span>
      <nav aria-label="Footer">
        <a href={href('/')}>Index</a>
        <a href={href('/about/')}>About</a>
        <a href={href('/contact/')}>Contact</a>
        <a class="top" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(3.5rem, 8vw, 7rem) 2rem;
    background: var(--footer-bg);
    color: var(--footer-ink);
  }
  /* Without the call to action only the base line is left. */
  .site-footer.slim {
    padding-top: 0.25rem;
  }
  /* On a tall enough window the footer waits at the bottom and the page lifts off it.
     It has to fit inside the window for that, so short windows keep the plain flow. */
  @media (min-height: 720px) {
    .site-footer {
      position: sticky;
      bottom: 0;
      z-index: 0;
    }
  }
  .label {
    color: var(--footer-ink-2);
  }
  .cta {
    margin-top: 1.25rem;
    font-size: clamp(2.4rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    overflow: hidden;
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
  }
  .cta-line {
    display: inline-block;
  }
  /* The heading rises out of its mask over the last stretch of the page's scroll. */
  @keyframes cta-rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes links-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }
  @media (prefers-reduced-motion: no-preference) and (min-height: 720px) {
    @supports (animation-timeline: scroll()) {
      .cta-line {
        animation: cta-rise linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(100% - 420px) calc(100% - 120px);
      }
      .links {
        animation: links-in linear both;
        animation-timeline: scroll(root block);
        animation-range: calc(100% - 260px) calc(100% - 40px);
      }
    }
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3.5rem);
    list-style: none;
  }
  .pill {
    --fill: var(--footer-ink);
    --fill-ink: var(--footer-bg);
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.85em 1.5em;
    border: 1px solid var(--footer-rule);
    border-radius: 999px;
    text-decoration: none;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.35s var(--ease),
      transform 0.45s cubic-bezier(0.2, 1.5, 0.4, 1);
  }
  .pill:hover {
    border-color: var(--footer-ink);
  }
  .pill.primary {
    background: var(--footer-ink);
    border-color: var(--footer-ink);
    color: var(--footer-bg);
  }
  .pill.primary:hover {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }
  .pill-arrow {
    transition: transform 0.35s var(--ease);
  }
  .pill:hover .pill-arrow {
    transform: translateX(0.3rem);
  }
  .site-footer :focus-visible {
    outline-color: var(--footer-ink);
  }
  .placeholder,
  .dev-note {
    color: var(--footer-ink-2);
  }
  .dev-note {
    margin-top: 1rem;
  }
  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(3rem, 7vw, 6rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--footer-rule);
    color: var(--footer-ink-2);
  }
  .slim .base {
    margin-top: 0;
    border-top: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.75rem;
  }
  .local {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
  }
  .local :global(.colon) {
    animation: blink 2s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .local :global(.colon) {
      animation: none;
    }
  }
  .base nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.9rem;
  }
  .base a {
    text-decoration: none;
  }
  .base a:hover {
    color: var(--footer-ink);
  }
  .top span {
    display: inline-block;
    transition: transform 0.35s var(--ease);
  }
  .top:hover span {
    transform: translateY(-3px);
  }
</style>
