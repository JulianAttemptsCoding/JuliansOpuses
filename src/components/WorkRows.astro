---
// One row per project, the full width of the column: its number, its title and the
// question it asks, where it stands, and its field. Each row assembles itself as it is
// scrolled to, and leans toward the reader when pointed at. Used for the short list on
// the home page and the lists on the Projects page. Pair it with one <RowPreview> per
// page for the figure that follows the cursor; where there is no cursor, each row shows
// its own figure instead.
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Verdict from './Verdict.astro';
import { href } from '../lib/url';

interface Props {
  items: CollectionEntry<'work'>[];
  /** Smaller titles, for the study under the main list. */
  small?: boolean;
}
const { items, small = false } = Astro.props;
const num = (n: number) => String(n).padStart(2, '0');
const rows = await Promise.all(
  items.map(async (w) => ({ w, img: await getImage({ src: w.data.cover, width: 900 }) })),
);
---

<ol class:list={['rows', { small }]}>
  {
    rows.map(({ w, img }) => (
      <li>
        <a class="row" href={href(`/work/${w.id}/`)} data-row={w.id} data-status={w.data.status}>
          <span class="num mono">{num(w.data.order)}</span>
          <span class="what">
            <span class="title display" style={`view-transition-name: work-${w.id}`}>
              {w.data.title}
            </span>
            <span class="question">{w.data.question}</span>
          </span>
          <span class="result">
            <Verdict status={w.data.status} />
            <span class="evidence">{w.data.evidence}</span>
          </span>
          <span class="domain">{w.data.domain}</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
          <span class="thumb" aria-hidden="true">
            <img
              src={img.src}
              alt=""
              loading="lazy"
              decoding="async"
              width={img.attributes.width}
              height={img.attributes.height}
            />
          </span>
        </a>
      </li>
    ))
  }
</ol>

<script>
  // The key to the labels doubles as a way to pick them out: pointing at one of its
  // entries (or focusing it) dims every project that has a different label: the rows,
  // and the entry a page leads with, if it has one.
  const rows = document.querySelectorAll<HTMLElement>('[data-row][data-status], [data-lead][data-status]');
  document.querySelectorAll<HTMLElement>('.legend [data-verdict]').forEach((key) => {
    const pick = (status: string | null) =>
      rows.forEach((r) => r.toggleAttribute('data-dim', status !== null && r.dataset.status !== status));
    key.addEventListener('pointerenter', () => pick(key.dataset.verdict!));
    key.addEventListener('pointerleave', () => pick(null));
    key.addEventListener('focus', () => pick(key.dataset.verdict!));
    key.addEventListener('blur', () => pick(null));
  });
</script>

<style>
  .rows {
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 20rem) 9rem 2rem;
    align-items: center;
    gap: 0 clamp(1rem, 2.5vw, 2.25rem);
    padding-block: clamp(1.5rem, 2.8vw, 2.4rem);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s var(--ease);
  }
  .row:hover {
    color: inherit;
  }
  /* The focus ring stands clear of the number on the left and the arrow on the right,
     which moves a little further out while the row has focus. */
  .row:focus-visible {
    outline-offset: 12px;
    border-radius: 4px;
  }
  .row[data-dim] {
    opacity: 0.3;
  }
  .num,
  .domain {
    color: var(--ink-3);
  }
  .domain {
    font-size: var(--t-sm);
  }
  .what {
    display: grid;
    gap: 0.5rem;
    transition: transform 0.45s var(--ease);
  }
  .title {
    width: fit-content;
    font-size: var(--t-row);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .small .title {
    font-size: var(--t-h2);
  }
  .question {
    max-width: 30rem;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.45;
    color: var(--ink-2);
  }
  /* The label sits above the cells after it, so its explanation is never underneath them. */
  .result {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 0.35rem;
  }
  .evidence {
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .arrow {
    justify-self: end;
    font-size: 1.3rem;
    color: var(--ink-3);
    transition:
      transform 0.45s var(--ease),
      color 0.3s;
  }
  /* The row's own figure: only where there is no cursor for a preview to follow, and
     only in the one-column layout, which has a place for it under the text. */
  .thumb {
    display: none;
  }

  /* A row being pointed at sits above its neighbours, so its label's explanation is not
     covered by the next row. */
  .rows > li:hover,
  .rows > li:focus-within {
    position: relative;
    z-index: 2;
  }

  /* Each row assembles as it arrives and comes apart as it leaves by the top: number,
     title out of its mask, then the rest. All the parts read one timeline, the row's own
     passage through the window. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .rows > li {
        view-timeline: --row block;
        view-timeline-inset: var(--header-h) 0px;
      }
      .row .num,
      .row .title,
      .row .question,
      .row .result,
      .row .domain,
      .row .arrow,
      .row .thumb {
        animation:
          reveal linear both,
          leave linear forwards;
        animation-timeline: --row, --row;
        animation-range:
          entry 60px entry 300px,
          exit calc(100% - 150px) exit 100%;
      }
      .row .num {
        animation-name: slide-in-left, leave;
        animation-range:
          entry 0px entry 220px,
          exit calc(100% - 150px) exit 100%;
      }
      .row .title {
        animation-name: unmask, leave;
        animation-range:
          entry 10px entry 250px,
          exit calc(100% - 150px) exit 100%;
      }
      .row .result {
        animation-range:
          entry 100px entry 340px,
          exit calc(100% - 150px) exit 100%;
      }
      /* These two move on hover, so only their opacity is animated here. */
      .row .domain,
      .row .arrow {
        animation-name: fade-in, fade-out;
        animation-range:
          entry 140px entry 380px,
          exit calc(100% - 150px) exit 100%;
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .rows:hover .row:not(:hover),
    .rows:focus-within .row:not(:focus-visible) {
      opacity: 0.45;
    }
    .rows:focus-within:not(:hover) .row:focus-visible {
      opacity: 1;
    }
    .row:hover .what,
    .row:focus-visible .what {
      transform: translateX(0.75rem);
    }
    .row:hover .arrow,
    .row:focus-visible .arrow {
      transform: translateX(0.4rem);
      color: var(--accent);
    }
  }

  /* Less room: the title and the question keep the first line, and the rest goes under
     them in the same column. */
  @media (max-width: 62.5em) {
    .row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      align-items: start;
      row-gap: 0.9rem;
    }
    .num {
      padding-top: 0.75em;
    }
    .result,
    .domain,
    .thumb {
      grid-column: 2 / -1;
    }
    .arrow {
      grid-column: 3;
      grid-row: 1;
      padding-top: 0.2em;
    }
    .evidence {
      max-width: 32rem;
    }
  }
  @media (max-width: 35em) {
    .row {
      grid-template-columns: 1.75rem minmax(0, 1fr) 1.25rem;
      column-gap: 0.75rem;
    }
  }
  @media (hover: none) and (max-width: 62.5em) {
    .thumb {
      display: block;
      padding: 0.6rem;
      background: var(--thumb);
      border: 1px solid var(--rule);
      border-radius: 4px;
      isolation: isolate;
    }
    .thumb img {
      width: 100%;
      max-height: 15rem;
      object-fit: contain;
      filter: var(--thumb-filter);
      mix-blend-mode: var(--thumb-blend);
    }
  }
</style>
