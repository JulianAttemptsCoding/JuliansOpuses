---
// One row per project: number, title, the question it asks, and how it did when tested.
// Used for the short list on the home page and the full list on the Projects page.
// Pair it with one <RowPreview> per page for the figure that follows the cursor.
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Verdict from './Verdict.astro';
import { href } from '../lib/url';

interface Props {
  items: CollectionEntry<'work'>[];
  /** Smaller titles, for the research notes under the main list. */
  small?: boolean;
}
const { items, small = false } = Astro.props;
const covers = Object.fromEntries(
  await Promise.all(items.map(async (w) => [w.id, await getImage({ src: w.data.cover, width: 900 })] as const)),
);
const num = (n: number) => String(n).padStart(2, '0');
---

<ol class:list={['rows', { small }]}>
  {
    items.map((w) => (
      <li>
        <a class="row" href={href(`/work/${w.id}/`)} data-row={w.id}>
          <span class="num mono">{num(w.data.order)}</span>
          <span class="main">
            <span class="title display" style={`view-transition-name: work-${w.id}`}>
              {w.data.title}
            </span>
            <span class="question">{w.data.question}</span>
          </span>
          <span class="result">
            <Verdict status={w.data.status} />
            <span class="evidence">{w.data.evidence}</span>
          </span>
          <span class="domain">{w.data.domain}</span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
          <img class="thumb" src={covers[w.id].src} alt="" loading="lazy" decoding="async" width="900" height="520" />
        </a>
      </li>
    ))
  }
</ol>

<style>
  .rows {
    list-style: none;
  }
  .row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 19rem) 9.5rem 2rem;
    align-items: center;
    gap: 0 clamp(1rem, 2.5vw, 2.5rem);
    padding-block: clamp(1.5rem, 3vw, 2.6rem);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    transition: opacity 0.3s var(--ease);
  }
  .row:hover {
    color: inherit;
  }
  .num,
  .domain {
    color: var(--ink-3);
  }
  .domain {
    font-size: 0.88rem;
  }
  .main {
    display: grid;
    gap: 0.5rem;
    transition: transform 0.45s var(--ease);
  }
  .title {
    font-size: clamp(1.9rem, 4vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    width: fit-content;
  }
  .small .title {
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
  }
  .question {
    max-width: 46ch;
    color: var(--ink-2);
    line-height: 1.4;
  }
  /* The verdict sits above the cells after it, so its explanation is never underneath them. */
  .result {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: 0.45rem;
  }
  .evidence {
    color: var(--ink-2);
    font-size: 0.88rem;
    line-height: 1.45;
  }
  .arrow {
    justify-self: end;
    font-size: 1.4rem;
    color: var(--ink-3);
    transition:
      transform 0.45s var(--ease),
      color 0.3s;
  }
  .thumb {
    display: none;
  }

  /* A row being pointed at sits above its neighbours, so its verdict's explanation is not
     covered by the next row. */
  .rows > li:hover,
  .rows > li:focus-within {
    position: relative;
    z-index: 2;
  }

  /* Each row assembles as it arrives and comes apart as it leaves by the top: number,
     title out of its mask, then the rest. All the parts read one timeline, the row's own
     passage through the window. */
  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .rows > li {
        view-timeline: --row block;
        view-timeline-inset: 64px 0px;
      }
      .row .num,
      .row .title,
      .row .question,
      .row .result,
      .row .domain,
      .row .arrow {
        animation:
          reveal linear both,
          leave linear forwards;
        animation-timeline: --row, --row;
        animation-range:
          entry 60px entry 300px,
          exit calc(100% - 150px) exit 100%;
      }
      .row .num {
        animation-name: slide-in-left, leave;
        animation-range:
          entry 0px entry 220px,
          exit calc(100% - 150px) exit 100%;
      }
      .row .title {
        animation-name: unmask, leave;
        animation-range:
          entry 10px entry 250px,
          exit calc(100% - 150px) exit 100%;
      }
      .row .result {
        animation-range:
          entry 100px entry 340px,
          exit calc(100% - 150px) exit 100%;
      }
      /* These two move on hover, so only their opacity is animated here. */
      .row .domain,
      .row .arrow {
        animation-name: fade-in, fade-out;
        animation-range:
          entry 140px entry 380px,
          exit calc(100% - 150px) exit 100%;
      }
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .rows:hover .row:not(:hover),
    .rows:focus-within .row:not(:focus-visible) {
      opacity: 0.45;
    }
    .rows:focus-within:not(:hover) .row:focus-visible {
      opacity: 1;
    }
    .row:hover .main,
    .row:focus-visible .main {
      transform: translateX(0.75rem);
    }
    .row:hover .arrow,
    .row:focus-visible .arrow {
      transform: translateX(0.4rem);
      color: var(--accent);
    }
  }

  @media (max-width: 960px) {
    .row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      align-items: start;
      row-gap: 1rem;
    }
    .num {
      padding-top: 0.6em;
    }
    .result {
      grid-column: 2 / -1;
      grid-row: 2;
    }
    .domain {
      grid-column: 2 / -1;
      grid-row: 3;
    }
    .arrow {
      grid-column: 3;
      grid-row: 1;
      padding-top: 0.15em;
    }
  }
  @media (hover: none) {
    .thumb {
      display: block;
      grid-column: 2 / -1;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      padding: 10px;
      object-fit: contain;
      background: var(--fig);
      border: 1px solid var(--rule);
      border-radius: 8px;
    }
  }
</style>
