---
// Awards as one list of equal rows. The home page shows the first few; the Experience
// page shows them all.
import Rich from './Rich.astro';
import { recognition } from '../data/profile';

interface Props {
  /** Show only the first n entries. */
  limit?: number;
}
const { limit } = Astro.props;
const items = limit ? recognition.slice(0, limit) : recognition;
---

<ul class="awards" data-stagger>
  {
    items.map((r) => (
      <li>
        <a class="award-name ext" href={r.href} rel="noopener">{r.name}</a>
        <span class="award-result">{r.result}</span>
        <span class="award-note">
          <Rich parts={r.note} />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .awards {
    list-style: none;
  }
  .awards li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 3fr) minmax(0, 6fr);
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--rule);
  }
  .awards li:first-child {
    padding-top: 0;
  }
  .award-name {
    display: inline-block;
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      transform 0.4s var(--ease),
      color 0.2s;
  }
  .awards li:hover .award-name {
    transform: translateX(0.5rem);
  }
  .award-result {
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 0.25s;
  }
  .awards li:hover .award-result {
    color: var(--accent-2);
  }
  .award-note {
    color: var(--ink-3);
    font-size: 0.92rem;
    line-height: 1.45;
  }
  @media (max-width: 720px) {
    .awards li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
