---
// Awards as one table of equal rows: the award, the result, and a note beside them. It
// sits in a ledger section's content, so its rows are set on the same nine columns. The
// home page shows the first few; the Experience page shows them all.
import Rich from './Rich.astro';
import { recognition } from '../data/profile';

interface Props {
  /** Show only the first n entries. */
  limit?: number;
}
const { limit } = Astro.props;
const items = limit ? recognition.slice(0, limit) : recognition;
---

<ul class="awards" data-stagger>
  {
    items.map((r) => (
      <li class="g9">
        <a class="award-name ext" href={r.href} rel="noopener">{r.name}</a>
        <span class="award-result">{r.result}</span>
        <span class="award-note">
          <Rich parts={r.note} />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .awards {
    list-style: none;
  }
  .awards li {
    row-gap: 0.2rem;
    align-items: first baseline;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--rule);
  }
  .awards li:first-child {
    padding-top: 0;
  }
  .award-name {
    grid-column: 1 / span 4;
    justify-self: start;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.4;
    text-decoration: none;
  }
  .award-result {
    grid-column: 5 / span 2;
    font-size: var(--t-sm);
    font-weight: 500;
  }
  .award-note {
    grid-column: 7 / -1;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  /* Less room: the name and the result share a line, and the note goes under them. */
  @media (max-width: 62.5em) {
    .award-name {
      grid-column: 1 / span 6;
    }
    .award-result {
      grid-column: 7 / -1;
    }
    .award-note {
      grid-column: 1 / -1;
      max-width: 32rem;
    }
  }
  @media (max-width: 35em) {
    .award-name,
    .award-result {
      grid-column: 1 / -1;
    }
  }
</style>
