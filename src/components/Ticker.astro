---
// A slow band of the fields the work sits in. It drifts at one steady speed, pauses under
// the pointer, and stops with everything else when the reader presses Pause. The mark
// between the names is a plain stroke: the five status symbols mean something on this
// site, so they are not used as decoration. Decorative: everything in it is stated
// elsewhere on the page, so it is hidden from assistive tech.
const fields = [
  'Experimental high-energy physics',
  'Detector simulation',
  'Graph forecasting',
  'Indoor positioning',
  'Web security',
  'Math modeling',
  'Quantitative research',
];
// Six identical copies in a row. The track slides left by exactly one copy and starts over,
// which looks continuous, and six copies are wider than any window, so no end is ever visible.
const COPIES = 6;
const copies = Array.from({ length: COPIES }, (_, i) => i);
---

<div class="ticker" aria-hidden="true">
  <div class="track">
    {
      copies.map(() => (
        <ul>
          {fields.map((f) => (
            <li>
              <span>{f}</span>
              <span class="sep">/</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  /* The band runs the full width of the window. It has the page's own surface and sits
     above the section ticks, so they pass under it instead of over its words. */
  .ticker {
    position: relative;
    z-index: 31;
    overflow: hidden;
    border-block: 1px solid var(--rule);
    padding-block: 0.8rem;
    background: var(--paper);
  }
  .track {
    display: flex;
    width: max-content;
  }
  ul {
    display: flex;
    flex: none;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding-right: clamp(1.25rem, 2.5vw, 2rem);
    font-size: var(--t-lg);
    letter-spacing: -0.01em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .sep {
    flex: none;
    color: var(--ink-3);
    font-weight: 300;
  }

  @keyframes tick {
    to {
      transform: translateX(calc(-100% / 6));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: tick 38s linear infinite;
    }
    .ticker:hover .track,
    :global(html[data-motion='paused']) .track {
      animation-play-state: paused;
    }
  }
</style>
