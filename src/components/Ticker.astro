---
// A slow band of the fields the work sits in, separated by the five verdict glyphs.
// It drifts at one steady speed and pauses under the pointer. Decorative: everything in
// it is stated elsewhere on the page, so it is hidden from assistive tech.
import { STATUS_ORDER } from '../data/verdicts';

const fields = [
  'Scientific machine learning',
  'Detector simulation',
  'Graph forecasting',
  'Estimation',
  'Security engineering',
  'Quantitative research',
];
// Six identical copies in a row. The track slides left by exactly one copy and starts over,
// which looks continuous, and six copies are wider than any window, so no end is ever visible.
const COPIES = 6;
const copies = Array.from({ length: COPIES }, (_, i) => i);
---

<div class="ticker" aria-hidden="true">
  <div class="track">
    {
      copies.map(() => (
        <ul>
          {fields.map((f, i) => (
            <li>
              <span>{f}</span>
              <svg class:list={['glyph', STATUS_ORDER[i % STATUS_ORDER.length]]} viewBox="0 0 12 12" width="12" height="12">
                {STATUS_ORDER[i % 5] === 'holds' && <circle cx="6" cy="6" r="5" fill="currentColor" />}
                {STATUS_ORDER[i % 5] === 'open' && (
                  <>
                    <circle cx="6" cy="6" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5" />
                    <path d="M6 1.75a4.25 4.25 0 0 1 0 8.5z" fill="currentColor" />
                  </>
                )}
                {STATUS_ORDER[i % 5] === 'prototype' && (
                  <circle cx="6" cy="6" r="4.25" fill="none" stroke="currentColor" stroke-width="1.5" />
                )}
                {STATUS_ORDER[i % 5] === 'shipped' && (
                  <rect x="2.5" y="2.5" width="7" height="7" fill="currentColor" transform="rotate(45 6 6)" />
                )}
                {STATUS_ORDER[i % 5] === 'negative' && (
                  <path
                    d="M2.25 2.25l7.5 7.5M9.75 2.25l-7.5 7.5"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                  />
                )}
              </svg>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>


<style>
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--rule);
    padding-block: 0.85rem;
  }
  .track {
    display: flex;
    width: max-content;
  }
  ul {
    display: flex;
    flex: none;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    padding-right: clamp(1.25rem, 2.5vw, 2.25rem);
    font-size: clamp(1rem, 1.6vw, 1.3rem);
    letter-spacing: -0.02em;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .glyph {
    flex: none;
  }
  .holds {
    color: var(--v-holds);
  }
  .open {
    color: var(--v-open);
  }
  .prototype {
    color: var(--v-prototype);
  }
  .shipped {
    color: var(--v-shipped);
  }
  .negative {
    color: var(--v-negative);
  }

  @keyframes tick {
    to {
      transform: translateX(calc(-100% / 6));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: tick 38s linear infinite;
    }
    .ticker:hover .track {
      animation-play-state: paused;
    }
  }
</style>
