---
// Directional hit rate of QTA0 under four validation designs, ordered by strictness.
// Values are the test hit rates reported in the QTA0 repository. Picking a run shows
// what that test was, in plain terms, and how large the edge is on a full 0–100% scale.
const runs = [
  {
    id: 'run0',
    hit: 52.5,
    t: '+3.49',
    short: 'adjacent chrono',
    test: 'Chronological, adjacent to training',
    universe: '83 names',
    verdict: 'Beat SPY on return only',
    plain:
      'Tested on the period right after training. Out of every 1,000 up-or-down calls, 525 were right. A coin gets 500.',
  },
  {
    id: 'run1',
    hit: 51.1,
    t: '+5.36',
    short: 'CPCV · 28 folds',
    test: 'CPCV (8,2), 28 folds',
    universe: '196 names',
    verdict: 'Negative',
    plain:
      'Tested across 28 different train-and-test splits, with overlapping days removed so nothing leaks between them. 511 right per 1,000: a real edge, and too thin to survive trading costs.',
  },
  {
    id: 'run2',
    hit: 50.5,
    t: '+5.91',
    short: 'CPCV · 45 folds',
    test: 'CPCV (10,2), 45 folds',
    universe: '153 names',
    verdict: 'Negative',
    plain:
      'Tested across 45 splits on a second data source. 505 right per 1,000: still measurably above a coin, and smaller again.',
  },
  {
    id: 'run2.1',
    hit: 49.7,
    t: '−1.56',
    short: 'distant chrono',
    test: 'Chronological, distant from training',
    universe: '153 names',
    verdict: 'Negative, coin flip',
    plain:
      'Tested on a period far from the training years. 497 right per 1,000: no better than a coin. Whatever the model learned had faded.',
  },
];

const W = 600;
const H = 310;
const left = 50;
const right = 586;
const top = 28;
const bottom = 240;
const lo = 49;
const hi = 53;
const y = (v: number) => bottom - ((v - lo) / (hi - lo)) * (bottom - top);
const band = (right - left) / runs.length;
const x = (i: number) => left + band * (i + 0.5);
const ticks = [49, 50, 51, 52, 53];
const base = y(50);
const edge = (hit: number) => {
  const d = hit - 50;
  return `${d >= 0 ? '+' : '−'}${Math.abs(d).toFixed(1)}`;
};
---

<div class="fx chart" data-hit-chart>
  <div class="scroll">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      role="img"
      aria-label="Test hit rate by validation design: 52.5%, 51.1%, 50.5%, then 49.7%, falling toward and below the 50% coin-flip line as validation gets stricter."
    >
      {
        ticks.map((t) => (
          <g>
            <line class="grid" x1={left} x2={right} y1={y(t)} y2={y(t)} />
            <text class="tick" x={left - 10} y={y(t) + 4} text-anchor="end">
              {t}%
            </text>
          </g>
        ))
      }
      <line class="coin" x1={left} x2={right} y1={base} y2={base}></line>
      <text class="coin-label" x={right} y={base - 8} text-anchor="end">coin flip</text>

      {
        runs.map((r, i) => (
          <g class:list={['mark', { on: i === 0 }]} data-mark={i}>
            <rect class="band" x={left + band * i + 6} y={top - 14} width={band - 12} height={bottom - top + 62} rx="8" />
            <line class="stem" x1={x(i)} x2={x(i)} y1={base} y2={y(r.hit)} />
            <circle class="dot" cx={x(i)} cy={y(r.hit)} r="6" />
            <text class="value" x={x(i)} y={r.hit >= 50 ? y(r.hit) - 14 : y(r.hit) + 24} text-anchor="middle">
              {r.hit.toFixed(1)}%
            </text>
            <text class="run" x={x(i)} y={bottom + 24} text-anchor="middle">
              {r.id}
            </text>
            <text class="sub" x={x(i)} y={bottom + 40} text-anchor="middle">
              {r.short}
            </text>
          </g>
        ))
      }
      <text class="sub" x={left} y={H - 6}>stricter validation →</text>
    </svg>
  </div>

  <div class="fx-controls picker">
    <div class="fx-group" role="group" aria-label="Run to inspect">
      <span class="fx-label">Pick a run</span>
      <div class="fx-seg">
        {
          runs.map((r, i) => (
            <button type="button" data-pick={i} aria-pressed={i === 0 ? 'true' : 'false'}>
              {r.id}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  {
    runs.map((r, i) => (
      <div class="detail" data-detail={i} hidden={i !== 0}>
        <p class="fx-insight">{r.plain}</p>

        <div class="full" aria-hidden="true">
          <p class="fx-label">The same result on a full 0–100% scale</p>
          <div class="bar">
            <span class="coin-part" />
            <span
              class:list={['edge', { under: r.hit < 50 }]}
              style={`left:${Math.min(r.hit, 50)}%;width:${Math.abs(r.hit - 50)}%`}
            />
            <span class="half" />
          </div>
          <div class="bar-ends mono">
            <span>0%</span>
            <span class="mid">50% coin flip</span>
            <span>100%</span>
          </div>
        </div>

        <dl class="fx-readout">
          <div>
            <dt>Test hit rate</dt>
            <dd>{r.hit.toFixed(1)}%</dd>
          </div>
          <div>
            <dt>Against a coin</dt>
            <dd>
              {edge(r.hit)} <small>points</small>
            </dd>
          </div>
          <div>
            <dt title="How many standard errors the hit rate sits from 50%.">t-statistic</dt>
            <dd>{r.t}</dd>
          </div>
          <div>
            <dt>Verdict</dt>
            <dd class="word">{r.verdict}</dd>
          </div>
        </dl>
        <p class="fx-note">
          {r.test} · {r.universe}
        </p>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-hit-chart]').forEach((root) => {
    const marks = [...root.querySelectorAll<SVGGElement>('[data-mark]')];
    const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const details = [...root.querySelectorAll<HTMLElement>('[data-detail]')];

    const select = (i: number) => {
      marks.forEach((m, k) => m.classList.toggle('on', k === i));
      picks.forEach((p, k) => p.setAttribute('aria-pressed', String(k === i)));
      details.forEach((d, k) => (d.hidden = k !== i));
    };
    picks.forEach((btn, i) => btn.addEventListener('click', () => select(i)));
    // The marks themselves are a shortcut for pointer users; the buttons are the control.
    marks.forEach((m, i) => m.addEventListener('click', () => select(i)));
  });
</script>

<style>
  .scroll {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 440px;
    max-width: 720px;
    height: auto;
    margin-inline: auto;
    font-family: var(--font-mono);
  }
  .grid {
    stroke: var(--fig-rule);
    stroke-width: 1;
  }
  .tick,
  .sub {
    font-size: 10.5px;
    fill: var(--fig-ink-3);
  }
  .coin {
    stroke: var(--fig-ink);
    stroke-width: 1.25;
    stroke-dasharray: 5 4;
  }
  .coin-label {
    font-size: 10.5px;
    fill: var(--fig-ink);
  }
  .mark {
    cursor: pointer;
  }
  .band {
    fill: var(--fig-ink);
    fill-opacity: 0;
    transition: fill-opacity 0.2s;
  }
  .mark:hover .band {
    fill-opacity: 0.04;
  }
  .mark.on .band {
    fill-opacity: 0.07;
  }
  .stem {
    stroke: var(--fig-accent);
    stroke-width: 2;
  }
  .dot {
    fill: var(--fig-accent);
    stroke: var(--fig);
    stroke-width: 2;
    transition: r 0.15s;
  }
  .mark.on .dot {
    r: 8;
  }
  .mark.on .stem {
    stroke-width: 3;
  }
  .value {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    fill: var(--fig-ink);
  }
  .run {
    font-size: 11.5px;
    fill: var(--fig-ink);
  }
  .mark.on .run {
    font-weight: 600;
  }

  .picker {
    margin-top: 0.9rem;
    padding-bottom: 0;
  }
  .detail .fx-insight {
    min-height: 4.4em;
  }

  /* The chart above is zoomed to 49–53%. This bar is not. */
  .full {
    margin-top: 1rem;
  }
  .bar {
    position: relative;
    height: 22px;
    margin-top: 0.45rem;
    background: var(--fig-shade);
    border: 1px solid var(--fig-rule);
    border-radius: 4px;
    overflow: hidden;
  }
  .coin-part {
    position: absolute;
    inset: 0 50% 0 0;
    background: color-mix(in srgb, var(--fig-ink) 16%, var(--fig));
  }
  .edge {
    position: absolute;
    top: 0;
    bottom: 0;
    min-width: 2px;
    background: var(--fig-accent);
  }
  .edge.under {
    background: var(--fig);
    outline: 1px solid var(--fig-accent);
    outline-offset: -1px;
  }
  .half {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    border-left: 1.5px dashed var(--fig-ink);
  }
  .bar-ends {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 0.3rem;
    font-size: 0.66rem;
    color: var(--fig-ink-3);
  }
  .bar-ends .mid {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    color: var(--fig-ink);
  }
  .word {
    font-size: 1rem;
    line-height: 1.3;
    padding-block: 0.3rem;
    letter-spacing: -0.01em;
  }
</style>
