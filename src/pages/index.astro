---
// Home: who I am in one screen, then a short version of each section with a link to the
// full one. The research and the projects are one list, since the research is the first
// project: it is set out larger, with the lab it was done in, and the others follow as
// rows. Then what I do outside the lab, then the awards. The sections are not all one
// shape: the projects run the full width, the others hang from their names. Nothing here
// is the only copy of anything.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Verdict from '../components/Verdict.astro';
import Ticker from '../components/Ticker.astro';
import WorkRows from '../components/WorkRows.astro';
import RowPreview from '../components/RowPreview.astro';
import Awards from '../components/Awards.astro';
import Shower from '../components/Shower.astro';
import { href } from '../lib/url';
import { STATUS_ORDER } from '../data/verdicts';
import { experience, links, recognition } from '../data/profile';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
// The research project leads; the next three follow as rows.
const [lead, ...others] = all;
const rows = others.slice(0, 3);
const cover = await getImage({ src: lead.data.cover, width: 1200 });
const num = (n: number) => String(n).padStart(2, '0');
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const sections = [
  { id: 'work', label: 'Projects' },
  { id: 'beyond', label: 'Outside the lab' },
  { id: 'awards', label: 'Awards' },
];
// The headline is split into pieces at build time so each can rise out of its own mask.
// A piece is usually one word. Words joined by `_` stay together as one piece, so a name
// is never split across two lines and "I" never dangles at the end of one. `b` marks the
// name, the one thing in the sentence set heavier; `tail` is punctuation that follows a
// word without taking its weight. A word ending in `/` ends a line on anything wider than
// a phone: there the sentence is always these five lines, whatever font is drawn, so a
// late-arriving font cannot add a line and push the page down. On a phone the lines wrap
// on their own. A word ending in `+` is kept beside the next one on a narrow phone only,
// where the two would otherwise end up one to a line.
type Piece = { t: string; b?: boolean; tail?: string; keep?: boolean; brk?: boolean };
const NBSP = String.fromCharCode(160);
const pieces: Piece[] = [
  { t: 'I’m' },
  { t: 'Julian', b: true },
  { t: 'Juan', b: true, tail: ',' },
  ...'a senior at/ Los_Gatos High School. I_do/ physics research, build software/ and hardware, and model+/ problems mathematically.'
    .split(' ')
    .map((raw) => {
      const brk = raw.endsWith('/');
      const word = brk ? raw.slice(0, -1) : raw;
      return { t: word.replace(/_/g, NBSP).replace(/\+$/, ''), keep: word.endsWith('+'), brk };
    }),
];
// Each piece keeps its place in the sentence (for the order it rises in); a kept pair is
// one group.
const headline: (Piece & { i: number })[][] = [];
pieces.forEach((p, i) => {
  const last = headline[headline.length - 1];
  if (last && last[last.length - 1].keep) last.push({ ...p, i });
  else headline.push([{ ...p, i }]);
});
---

<Base sections={sections}>
  <section class="hero wrap g12">
    <h1>
      {
        headline.map((group) => {
          const words = group.map((w, k) => (
            <>
              <span class="w">
                <span style={`--i:${w.i}`}>
                  {w.b ? <strong>{w.t}</strong> : w.t}
                  {w.tail}
                </span>
              </span>
              {w.brk && <br class="brk" />}
              {k < group.length - 1 && ' '}
            </>
          ));
          return (
            <>
              {group.length > 1 ? <span class="pair">{words}</span> : words}{' '}
            </>
          );
        })
      }
    </h1>
    <div class="hero-fig">
      <Shower />
    </div>
    <div class="hero-foot g12">
      <div class="main">
        <p class="lede">
          I’ve spent two summers doing detector research at Academia Sinica’s Institute of Physics in Taipei. I
          also hold the student vote on the committee for my school district’s $88 million budget, and I direct
          strategy for a student hackathon.
        </p>
        <ul class="hero-links">
          <li><a href="#work">Research and projects&nbsp;↓</a></li>
          <li><a href="#beyond">Outside the lab&nbsp;↓</a></li>
          <li><a href="#awards">Awards&nbsp;↓</a></li>
        </ul>
      </div>
      <dl class="facts side">
        <div>
          <dt>Research</dt>
          <dd><a class="ext quiet" href={experience.href} rel="noopener">{experience.org}</a></dd>
        </div>
        <div>
          <dt>School</dt>
          <dd><a class="ext quiet" href={links.lghs} rel="noopener">Los Gatos High School, Class of 2027</a></dd>
        </div>
        <div>
          <dt>College</dt>
          <dd>
            <a class="quiet" href={href('/about/#education')}>29 units alongside high school, 4.0 GPA&nbsp;→</a>
          </dd>
        </div>
        <div>
          <dt>Leadership</dt>
          <dd>
            <a class="quiet" href={href('/experience/#leadership')}>
              District budget committee, Los Gatos Hacks&nbsp;→
            </a>
          </dd>
        </div>
        <div>
          <dt>Awards</dt>
          <dd>
            <a class="quiet" href={href('/experience/#awards')}>
              {recognition[0].name} {recognition[0].result.toLowerCase()}, and {recognition.length - 1} more&nbsp;→
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <Ticker />

  <section class="section wrap" id="work">
    <header class="sec-head" data-rule>
      <div>
        <h2 class="sec-title marked"><span data-reveal="mask">Research and projects</span></h2>
        <p class="sec-intro" data-reveal>
          Four of five. The first is my research at Academia Sinica. The label on each says where it stands.
        </p>
      </div>
      <ul class="legend" data-reveal aria-label="What the labels mean. Point at or focus one to read it.">
        {
          STATUS_ORDER.map((s) => (
            <li>
              <Verdict status={s} bare />
            </li>
          ))
        }
      </ul>
    </header>

    <!-- The research and the project that came out of it are one thing, so they are one
         entry: the lab, the project, where it stands, and the rest of the work there. -->
    <article class="lead" data-lead data-vt-scope data-status={lead.data.status}>
      <span class="lead-num mono" data-reveal="left">{num(lead.data.order)}</span>
      <div class="lead-text">
        <p class="lead-where" data-reveal>
          <span>
            {experience.role} at the{' '}
            <a class="ext" href={experience.href} rel="noopener">{experience.org}</a>
          </span>
          <span class="lead-when">{experience.place}, {experience.dates}</span>
        </p>
        <h3 class="lead-title display" data-vt={`work-${lead.id}`} data-reveal>
          <a class="quiet" href={href(`/work/${lead.id}/`)}>{lead.data.title}</a>
        </h3>
        <p class="lead-question" data-reveal>{lead.data.question}</p>
        <p class="lead-summary read" data-reveal>
          {experience.summary}{' '}
          {lead.data.title} is a machine-learning model that generates particle showers directly, in place of Geant4,
          the standard detector simulator.
        </p>
        <div class="lead-result" data-reveal>
          <Verdict status={lead.data.status} />
          <span>{lead.data.evidence}</span>
        </div>
        <p class="onward" data-reveal>
          <a href={href(`/work/${lead.id}/`)}>Read the write-up&nbsp;→</a>
        </p>
      </div>
      <div class="lead-side">
        <figure class="lead-fig" data-reveal="scale">
          <a class="frame" href={href(`/work/${lead.id}/`)} tabindex="-1" aria-hidden="true">
            <img
              src={cover.src}
              alt=""
              loading="lazy"
              decoding="async"
              width={cover.attributes.width}
              height={cover.attributes.height}
            />
          </a>
          <figcaption>{lead.data.coverAlt}</figcaption>
        </figure>
        <div class="lead-lab">
          <p class="lead-lab-name" data-reveal>What I worked on at the lab</p>
          <ol class="side-list strands" data-stagger>
            {
              experience.strands.map((s) => (
                <li>
                  <a class="quiet" href={href(`/experience/#${slug(s.title)}`)}>
                    <span>{s.title}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </article>

    <WorkRows items={rows} />
    <p class="onward" data-reveal>
      <a href={href('/work/')}>All five projects&nbsp;→</a>
    </p>
  </section>

  <section class="section wrap ledger" id="beyond" data-rule>
    <h2 class="sec-title marked"><span data-reveal="mask-in">Outside the lab</span></h2>
    <div>
      <ul class="beyond" data-stagger>
        <li class="g9">
          <p class="read">
            I’m the voting student member of my school district’s budget advisory committee, which oversees an
            $88 million budget. I helped find and reconcile over $6 million in reporting differences.
          </p>
          <a class="quiet" href={href('/experience/#leadership')}>Budget committee&nbsp;→</a>
        </li>
        <li class="g9">
          <p class="read">
            I’m Director of Strategy at Los Gatos Hacks, a nonprofit hackathon for middle and high school
            students that has more than doubled over four events, from 50 hackers to 115.
          </p>
          <a class="quiet" href={href('/experience/#leadership')}>Los Gatos Hacks&nbsp;→</a>
        </li>
        <li class="g9">
          <p class="read">
            I started a résumé workshop that is now part of freshman and sophomore English at my school.
          </p>
          <a class="quiet" href={href('/experience/#leadership')}>Résumé workshop&nbsp;→</a>
        </li>
      </ul>
      <p class="onward" data-reveal>
        <a href={href('/experience/#leadership')}>All leadership and activities&nbsp;→</a>
      </p>
    </div>
  </section>

  <section class="section wrap ledger" id="awards" data-rule>
    <h2 class="sec-title marked"><span data-reveal="mask-in">Awards</span></h2>
    <div>
      <Awards limit={4} />
      <p class="onward" data-reveal>
        <a href={href('/experience/#awards')}>All ten&nbsp;→</a>
      </p>
    </div>
  </section>

  <RowPreview items={rows} />
</Base>

<style>
  /* ---------- Opening ----------
     The sentence, with the detector drawing beside it, then a paragraph and the plain
     facts. It is sized by the window's height as well as its width, so that on a short
     laptop window all of it shares the first screen. On a narrower window the drawing
     goes under the facts. */
  .hero {
    row-gap: 0;
    align-items: end;
    padding-block: clamp(2.5rem, min(8vw, 10vh), 6.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .hero h1,
  .hero-fig,
  .hero-foot {
    grid-column: 1 / -1;
    min-width: 0;
  }
  /* The measure is in em, not ch: a ch is the width of the font's zero, which differs
     between the real font and its stand-in. */
  .hero h1 {
    max-width: 12.75em;
    font-size: var(--t-hero);
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: pretty;
  }
  /* The name is the one thing in the sentence set heavier. */
  .hero h1 strong {
    font-weight: 600;
  }
  /* Each word sits in a mask a little taller than the line, so descenders are not cut. */
  .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }
  .w > span {
    display: inline-block;
  }
  /* Wider than a phone, the sentence breaks only where it is told to. */
  @media (min-width: 37.5em) {
    .hero h1 {
      max-width: none;
      white-space: nowrap;
    }
  }
  @media not all and (min-width: 37.5em) {
    .brk {
      display: none;
    }
  }
  /* Two words that stay on one line together, on a narrow phone only. */
  @media (max-width: 23em) {
    .pair {
      white-space: nowrap;
    }
  }
  /* Under the sentence: a few more sentences, and the plain facts beside them. */
  .hero-foot {
    row-gap: 2rem;
    align-items: end;
    margin-top: clamp(1.5rem, min(4.5vw, 5.6vh), 3.5rem);
  }
  /* The ways down the page, in the order the page runs. */
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.1rem;
    list-style: none;
    font-size: var(--t-sm);
  }
  .hero-links a {
    display: inline-block;
    padding-block: 0.15rem;
  }
  .facts {
    font-size: var(--t-sm);
  }
  .facts div {
    display: grid;
    grid-template-columns: 5.25rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
  }
  .facts div:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    color: var(--ink-3);
  }
  .facts dd {
    text-wrap: balance;
  }
  /* The drawing. Beside the sentence it takes the five columns the facts take under it,
     and is never taller than the sentence: its width is worked out from the sentence's
     height (five lines), less the room its scale and caption need. */
  .hero-fig {
    order: 3;
    margin-top: clamp(2.25rem, 5vw, 4rem);
  }
  @media (min-width: 62.5em) {
    .hero h1 {
      grid-column: 1 / span 7;
    }
    .hero-fig {
      order: 0;
      grid-column: 8 / -1;
      grid-row: 1;
      max-width: calc((5.4 * var(--t-hero) - 6.4rem) * 2.95);
      margin-top: 0;
    }
  }

  /* The headline rises word by word; the rest of the opening follows. On a first visit
     it waits for the intro curtain. Without scripts none of this applies. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .w > span {
      animation: rise 0.9s var(--ease) both;
      animation-delay: calc(var(--i) * 34ms + var(--enter, 0.1s));
    }
    :global(html.js) .hero-foot {
      animation: fade-up 0.8s var(--ease) both;
      animation-delay: calc(var(--enter, 0.1s) + 0.6s);
    }
    :global(html.js) .hero-fig {
      animation: fade-up 0.9s var(--ease) both;
      animation-delay: calc(var(--enter, 0.1s) + 0.5s);
    }
    /* Leaving the top of the page, the headline lags behind a little and thins out. It
       only starts once the opening has been scrolled a good way, so nothing is dimmed
       while it is still being read. Not on a phone. */
    @supports (animation-timeline: scroll()) {
      @media (min-width: 43.75em) {
        .hero h1 {
          animation: hero-out linear both;
          animation-timeline: scroll(root block);
          animation-range: 30vh 95vh;
        }
      }
    }
  }
  @keyframes hero-out {
    to {
      opacity: 0.2;
      transform: translateY(36px);
    }
  }

  /* ---------- Projects: the key to the labels sits beside the section's name ---------- */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 1.1rem;
    list-style: none;
    color: var(--ink-2);
  }

  /* ---------- The research: the first entry of the list, opened out ----------
     It is set on the rows' own columns, so its number and its title stand where theirs
     do and its figure starts where their results start. What makes it the main one is
     size: a larger title, the lab above it, its figure beside it. */
  .lead {
    --g: clamp(1rem, 2.5vw, 2.25rem);
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) min(calc(31rem + 2 * var(--g)), 50%);
    column-gap: var(--g);
    align-items: start;
    padding-block: clamp(2rem, 3.8vw, 3.25rem);
    border-bottom: 1px solid var(--rule);
    transition: opacity 0.3s var(--ease);
  }
  /* Picking a label in the key dims the entries that carry a different one. */
  .lead[data-dim] {
    opacity: 0.3;
  }
  .lead-num {
    color: var(--ink-3);
    line-height: 1.3125rem;
  }
  .lead-text {
    display: grid;
    justify-items: start;
  }
  /* Where it was done: the lab on one line, the place and the dates under it. */
  .lead-where {
    display: grid;
    gap: 0.1rem;
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .lead-when {
    color: var(--ink-3);
  }
  .lead-title {
    margin-top: 1.1rem;
    font-size: var(--t-lead);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.024em;
  }
  .lead-title a {
    text-decoration-thickness: 1.5px;
  }
  .lead-question {
    max-width: 28rem;
    margin-top: 0.85rem;
    font-family: var(--font-display);
    font-size: var(--t-xl);
    line-height: 1.4;
  }
  .lead-summary {
    margin-top: 0.85rem;
    color: var(--ink-2);
  }
  .lead-result {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    width: 100%;
    margin-top: 1.3rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  /* The result is the proof: reading size, main ink. */
  .lead-result > span:last-child {
    max-width: 30rem;
    color: var(--ink);
    font-size: var(--t-md);
  }
  .lead-fig {
    margin: 0;
  }
  .frame {
    display: block;
    padding: clamp(0.6rem, 1.2vw, 1rem);
    background: var(--thumb);
    border: 1px solid var(--rule);
    border-radius: 4px;
    isolation: isolate;
  }
  .frame img {
    width: 100%;
    height: auto;
    filter: var(--thumb-filter);
    mix-blend-mode: var(--thumb-blend);
  }
  .lead-fig figcaption {
    margin-top: 0.55rem;
    color: var(--ink-3);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  /* The three pieces of work at the lab. Each goes to its account on the Experience page. */
  .lead-lab {
    margin-top: clamp(1.5rem, 2.6vw, 2.25rem);
  }
  .lead-lab-name {
    margin-bottom: 0.55rem;
    color: var(--ink-3);
    font-size: var(--t-sm);
  }
  .strands li {
    color: var(--ink-2);
  }
  /* The arrow sits at the end of the row, so the names keep one left edge. */
  .strands a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.1rem;
  }

  /* ---------- Outside the lab: a sentence each, with its link beside it ---------- */
  .beyond {
    list-style: none;
  }
  .beyond li {
    row-gap: 0.3rem;
    align-items: first baseline;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--rule);
  }
  .beyond li:first-child {
    padding-top: 0;
  }
  .beyond p {
    grid-column: 1 / span 6;
  }
  .beyond a {
    grid-column: 7 / -1;
    justify-self: start;
    padding-block: 0.1rem;
    font-size: var(--t-sm);
    white-space: nowrap;
  }

  /* Less room: the entry becomes one column beside its number, as the rows do, and its
     figure goes under its text. */
  @media (max-width: 62.5em) {
    .lead {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      row-gap: 1.75rem;
    }
    .lead-side {
      grid-column: 2;
      max-width: 34rem;
    }
    .beyond p,
    .beyond a {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 35em) {
    .lead {
      grid-template-columns: 1.75rem minmax(0, 1fr);
      column-gap: 0.75rem;
    }
  }
</style>
