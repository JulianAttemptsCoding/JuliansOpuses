---
// Home: who I am in one screen, then a short version of each section with a link to the
// full one. Nothing here is the only copy of anything.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Verdict from '../components/Verdict.astro';
import Ticker from '../components/Ticker.astro';
import WorkRows from '../components/WorkRows.astro';
import RowPreview from '../components/RowPreview.astro';
import Awards from '../components/Awards.astro';
import { href } from '../lib/url';
import { STATUS_ORDER } from '../data/verdicts';
import { experience, links } from '../data/profile';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = all.slice(0, 3);
// The headline is split into words at build time so each can rise out of its own mask.
const headline =
  'I’m Julian Juan, a senior at Los Gatos High School. I do machine-learning research for particle physics.'.split(' ');
---

<Base>
  <section class="hero wrap">
    <h1>
      {
        headline.map((word, i) => (
          <>
            <span class="w">
              <span style={`--i:${i}`}>{word}</span>
            </span>{' '}
          </>
        ))
      }
    </h1>
    <div class="hero-foot">
      <p class="lede">
        I’ve spent two summers at Academia Sinica’s Institute of Physics in Taipei, building models for particle
        detectors. Each project on this site says how it did when I tested it properly, including the one that
        failed.
      </p>
      <dl class="facts">
        <div>
          <dt>Research</dt>
          <dd><a class="ext quiet" href={experience.href} rel="noopener">{experience.org}</a></dd>
        </div>
        <div>
          <dt>School</dt>
          <dd><a class="ext quiet" href={links.lghs} rel="noopener">Los Gatos High School, Class of 2027</a></dd>
        </div>
        <div>
          <dt>College</dt>
          <dd><a class="quiet" href={href('/about/#education')}>29 units alongside high school, 4.0 GPA →</a></dd>
        </div>
        <div>
          <dt>Awards</dt>
          <dd><a class="quiet" href={href('/experience/#awards')}>HiMCM finalist, and nine more →</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <Ticker />

  <section class="section wrap" id="work">
    <header class="sec-head">
      <div>
        <h2 class="label marked">Projects</h2>
        <p class="sec-intro">Three of five. Each is labelled with how it did when tested.</p>
      </div>
      <ul class="legend" aria-label="What the labels mean. Point at or focus one to read it.">
        {
          STATUS_ORDER.map((s) => (
            <li>
              <Verdict status={s} bare />
            </li>
          ))
        }
      </ul>
    </header>
    <WorkRows items={featured} />
    <p class="onward" data-reveal>
      <a href={href('/work/')}>All five projects, including the one that failed →</a>
    </p>
  </section>

  <section class="section wrap ledger" id="research" data-rule>
    <h2 class="label marked ledger-label">Research</h2>
    <div>
      <p class="exp-org display" data-reveal="mask">
        <a class="ext quiet" href={experience.href} rel="noopener">{experience.org}</a>
      </p>
      <p class="exp-meta" data-reveal>
        {experience.role} in {experience.place}, {experience.dates}
      </p>
      <p class="exp-summary" data-reveal>
        {experience.summary} The longest piece was a machine-learning stand-in for the detector simulation. An
        early version generated showers about 200× faster in benchmarks, and I’m still working out whether they
        are accurate enough to use.
      </p>
      <p class="onward" data-reveal>
        <a href={href('/experience/')}>What I worked on there →</a>
      </p>
    </div>
  </section>

  <section class="section wrap ledger" id="awards" data-rule>
    <h2 class="label marked ledger-label">Awards</h2>
    <div>
      <Awards limit={4} />
      <p class="onward" data-reveal>
        <a href={href('/experience/#awards')}>All ten →</a>
      </p>
    </div>
  </section>

  <section class="section wrap ledger" id="beyond" data-rule>
    <h2 class="label marked ledger-label">Outside the lab</h2>
    <div>
      <ul class="beyond" data-stagger>
        <li>
          I’m the voting student member of my school district’s budget advisory committee, where I helped
          reconcile over $6 million in reporting differences.{' '}
          <a href={href('/experience/#leadership')}>More →</a>
        </li>
        <li>
          I’m Director of Strategy at Los Gatos Hacks, a nonprofit hackathon for middle and high school students.{' '}
          <a href={href('/about/#outside')}>More →</a>
        </li>
        <li>
          I started a résumé workshop that is now part of freshman and sophomore English at my school.{' '}
          <a href={href('/experience/#leadership')}>More →</a>
        </li>
      </ul>
      <p class="onward" data-reveal>
        <a href={href('/about/')}>Education, coursework and the rest →</a>
      </p>
    </div>
  </section>

  <RowPreview items={featured} />
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    padding-block: clamp(3rem, 9vw, 7.5rem) clamp(2.5rem, 6vw, 5rem);
  }
  .hero h1 {
    max-width: 25ch;
    font-size: clamp(2.05rem, 4.5vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.022em;
    text-wrap: pretty;
  }
  /* Each word sits in a mask a little taller than the line, so descenders are not cut. */
  .w {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.16em;
    margin-bottom: -0.16em;
  }
  .w > span {
    display: inline-block;
  }
  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
    align-items: end;
    margin-top: clamp(2.25rem, 5vw, 4rem);
  }
  .lede {
    max-width: 46ch;
    font-size: clamp(1.08rem, 1.45vw, 1.3rem);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .facts {
    font-size: 0.92rem;
  }
  .facts div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding-block: 0.6rem;
    border-top: 1px solid var(--rule);
  }
  .facts div:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    color: var(--ink-3);
  }

  /* The headline rises word by word; the rest of the hero follows. On a first visit it
     waits for the intro curtain. Without scripts none of this applies. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .w > span {
      animation: rise 0.9s var(--ease) both;
      animation-delay: calc(var(--i) * 38ms + var(--hero-delay, 0.1s));
    }
    :global(html.js) .hero-foot {
      animation: fade-up 0.8s var(--ease) both;
      animation-delay: calc(var(--hero-delay, 0.1s) + 0.6s);
    }
    :global(html.intro) .hero {
      --hero-delay: 1.3s;
    }
    :global(html.intro-skipped) .hero {
      --hero-delay: 0.1s;
    }
    /* Leaving the top of the page, the headline lags behind and thins out. */
    @supports (animation-timeline: scroll()) {
      .hero h1 {
        animation: hero-out linear both;
        animation-timeline: scroll(root block);
        animation-range: 0px 85vh;
      }
      .lede,
      .facts {
        animation: hero-out-fast linear both;
        animation-timeline: scroll(root block);
        animation-range: 0px 70vh;
      }
    }
  }
  @keyframes hero-out {
    to {
      opacity: 0.12;
      transform: translateY(70px);
    }
  }
  @keyframes hero-out-fast {
    to {
      opacity: 0;
      transform: translateY(-30px);
    }
  }

  /* ---------- Sections ---------- */
  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink);
  }
  .sec-intro {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    color: var(--ink-2);
  }

  .exp-org {
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1.1;
  }
  .exp-meta {
    margin-top: 0.6rem;
    color: var(--ink-3);
  }
  .exp-summary {
    max-width: 58ch;
    margin-top: 1.1rem;
    color: var(--ink-2);
    font-size: 1.08rem;
  }

  .beyond {
    list-style: none;
    max-width: 62ch;
  }
  .beyond li {
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .beyond li:first-child {
    padding-top: 0;
  }
  .beyond a {
    color: var(--ink);
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .hero-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
