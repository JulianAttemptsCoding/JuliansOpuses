---
// Experience: the research, every role outside the lab, and every award, in full.
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Awards from '../components/Awards.astro';
import { href } from '../lib/url';
import { experience, leadership, activities } from '../data/profile';

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
// Everything I have a role in: the two with a budget or a curriculum behind them first.
const roles = [...leadership, ...activities];

// A piece of work that became a project on this site is shown with that project's figure.
const work = await getCollection('work');
const strands = await Promise.all(
  experience.strands.map(async (s) => {
    const entry = s.link && work.find((w) => s.link!.path === `/work/${w.id}/`);
    return {
      ...s,
      fig: entry ? { img: await getImage({ src: entry.data.cover, width: 720 }), caption: entry.data.coverAlt } : null,
    };
  }),
);
---

<Base
  title="Experience"
  description="Julian Juan’s research at Academia Sinica, leadership and activities, and awards."
  sections={[
    { id: 'research', label: 'Research' },
    { id: 'leadership', label: 'Leadership' },
    { id: 'awards', label: 'Awards' },
  ]}
>
  <section class="page-intro wrap g12">
    <h1>Experience</h1>
    <p class="lede">Research, what I do outside the lab, and awards.</p>
  </section>

  <section class="section wrap ledger" id="research" data-rule>
    <h2 class="sec-title marked"><span data-reveal="mask-in">Research</span></h2>
    <div>
      <div class="g9 org">
        <div class="org-text">
          <h3 class="exp-org display" data-reveal="mask">
            <a class="ext quiet" href={experience.href} rel="noopener">{experience.org}</a>
          </h3>
          <p class="exp-summary read" data-reveal>{experience.summary} Three pieces of work came out of it.</p>
        </div>
        <dl class="facts" data-stagger>
          <div>
            <dt>Role</dt>
            <dd>{experience.role}</dd>
          </div>
          <div>
            <dt>Where</dt>
            <dd>{experience.place}</dd>
          </div>
          <div>
            <dt>When</dt>
            <dd class="when">{experience.dates}</dd>
          </div>
        </dl>
      </div>
      <ol class="strands" data-stagger>
        {
          strands.map((s) => (
            <li class="g9" id={slug(s.title)}>
              <div class="strand-text">
                <h4>{s.title}</h4>
                <p class="read">{s.body}</p>
                {s.link && (
                  <p class="more">
                    <a href={href(s.link.path)}>{s.link.label}&nbsp;→</a>
                  </p>
                )}
              </div>
              {s.link && s.fig && (
                <figure class="strand-fig">
                  <a class="frame" href={href(s.link.path)} tabindex="-1" aria-hidden="true">
                    <img
                      src={s.fig.img.src}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width={s.fig.img.attributes.width}
                      height={s.fig.img.attributes.height}
                    />
                  </a>
                  <figcaption>{s.fig.caption}</figcaption>
                </figure>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section wrap ledger" id="leadership" data-rule>
    <h2 class="sec-title marked"><span data-reveal="mask-in">Leadership and activities</span></h2>
    <div class="roles">
      {
        roles.map((l) => (
          <article class="role g9" data-reveal>
            <div class="role-text">
              <h3>
                {l.href ? (
                  <a class="ext quiet" href={l.href} rel="noopener">{l.title}</a>
                ) : (
                  l.title
                )}
              </h3>
              <p class="role-name">{l.role}</p>
              <p class="read">{l.body}</p>
              {'link' in l && l.link && (
                <p class="role-link">
                  <a class="ext" href={l.link.href} rel="noopener">{l.link.label}</a>
                </p>
              )}
            </div>
            {l.figures && l.figures.length > 0 && (
              <dl class="figures">
                {l.figures.map((f) => (
                  <div>
                    <dt>{f.label}</dt>
                    <dd data-count>{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section wrap ledger" id="awards" data-rule>
    <h2 class="sec-title marked"><span data-reveal="mask-in">Awards</span></h2>
    <Awards />
  </section>
</Base>

<style>
  /* ---------- Research: where it was, with the plain facts beside it ---------- */
  .org {
    align-items: first baseline;
    row-gap: 1.25rem;
  }
  .org-text {
    grid-column: 1 / span 6;
  }
  .exp-org {
    font-size: var(--t-org);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.018em;
  }
  .exp-summary {
    margin-top: 1rem;
  }
  .facts {
    grid-column: 7 / -1;
    font-size: var(--t-sm);
  }
  .facts div {
    display: grid;
    grid-template-columns: 3.75rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .facts div:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .facts dt {
    color: var(--ink-3);
  }
  /* The data says "summers of ...": as a value it reads better with a capital. */
  .when::first-letter {
    text-transform: uppercase;
  }

  /* Each piece of work: its name, then what it was. */
  .strands {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .strands li {
    row-gap: 0.9rem;
    align-items: start;
    padding-block: 1.1rem 1.25rem;
    border-bottom: 1px solid var(--rule);
  }
  .strand-text {
    grid-column: 1 / span 6;
  }
  .strands h4 {
    font-size: var(--t-lg);
    font-weight: 600;
    line-height: 1.4;
  }
  .strands p {
    margin-top: 0.3rem;
  }
  .strands .more {
    margin-top: 0.6rem;
    font-family: var(--font-sans);
    font-size: var(--t-sm);
  }
  /* The figure of the project that piece of work became, beside it. */
  .strand-fig {
    grid-column: 7 / -1;
    margin: 0;
  }
  .frame {
    display: block;
    padding: 0.6rem;
    background: var(--thumb);
    border: 1px solid var(--rule);
    border-radius: 4px;
    isolation: isolate;
  }
  .frame img {
    width: 100%;
    height: auto;
    filter: var(--thumb-filter);
    mix-blend-mode: var(--thumb-blend);
  }
  .strand-fig figcaption {
    margin-top: 0.5rem;
    color: var(--ink-3);
    font-size: var(--t-sm);
    line-height: 1.5;
  }

  /* ---------- Leadership: what I did, with its numbers beside it ---------- */
  .role {
    row-gap: 0.9rem;
    align-items: first baseline;
    padding-block: 1.2rem 1.4rem;
    border-bottom: 1px solid var(--rule);
  }
  .role:first-child {
    padding-top: 0;
  }
  .role-text {
    grid-column: 1 / span 6;
  }
  .role h3 {
    font-size: var(--t-h3);
    line-height: 1.25;
  }
  .role-name {
    margin-top: 0.3rem;
    color: var(--ink-3);
    font-size: var(--t-sm);
  }
  .role .read {
    margin-top: 0.9rem;
  }
  .role-link {
    margin-top: 0.5rem;
    font-size: var(--t-sm);
  }
  .figures {
    grid-column: 7 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.6rem 2rem;
  }
  .figures div {
    display: flex;
    flex-direction: column-reverse;
  }
  .figures dd {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }
  .figures dt {
    font-size: var(--t-xs);
    color: var(--ink-3);
  }

  @media (max-width: 62.5em) {
    .org-text,
    .facts,
    .strand-text,
    .strand-fig,
    .role-text,
    .figures {
      grid-column: 1 / -1;
    }
    .facts,
    .strand-fig {
      max-width: 26rem;
    }
  }
</style>
