---
import Base from '../layouts/Base.astro';
import Education from '../components/Education.astro';
import { href } from '../lib/url';
import { site } from '../data/site';
import { tools } from '../data/profile';
---

<Base
  title="About"
  description="About Julian Juan: what he likes working on, school and college coursework, and the tools he uses."
  sections={[
    { id: 'education', label: 'Education' },
    { id: 'tools', label: 'Tools' },
  ]}
>
  <section class="page-intro wrap g12">
    <h1>I like physics, math, computing, economics, and history about equally.</h1>
    <div class="lede">
      <p>
        What they have in common, for me, is that I enjoy taking something messy and finding a way to measure
        it.
      </p>
      <p>
        I’m a senior at Los Gatos High School. Alongside school I’ve completed 29 units of college math,
        statistics, computer science, and economics with a 4.0 GPA, and spent two summers doing research at
        Academia Sinica in Taipei.
      </p>
    </div>
    <ul class="side side-list links">
      <li><a class="quiet" href={href('/work/')}>Projects&nbsp;→</a></li>
      <li><a class="quiet" href={href('/experience/')}>Research, activities, and awards&nbsp;→</a></li>
      <li><a class="quiet" href={href('/contact/')}>Get in touch&nbsp;→</a></li>
      {
        site.linkedin && (
          <li>
            <a class="quiet ext" href={site.linkedin} rel="noopener">LinkedIn</a>
          </li>
        )
      }
      <li><a class="quiet ext" href={site.github} rel="noopener">GitHub</a></li>
    </ul>
  </section>

  <section class="section wrap ledger" id="education" data-rule>
    <h2 class="sec-title marked"><span data-reveal="mask-in">Education</span></h2>
    <Education />
  </section>

  <section class="section wrap ledger" id="tools" data-rule>
    <h2 class="sec-title marked"><span data-reveal="mask-in">Tools I use</span></h2>
    <p class="tools read" data-reveal>{tools.map((t) => t.label).join(', ')}.</p>
  </section>
</Base>

<style>
  /* The title here is a sentence, and the introduction under it runs to two paragraphs,
     with the ways on from this page beside them. */
  .page-intro {
    align-items: first baseline;
  }
  .page-intro h1 {
    max-width: 22em;
  }
  .page-intro .lede {
    display: grid;
    gap: 0.9rem;
  }

  @media (max-width: 56.25em) {
    .links {
      max-width: 26rem;
    }
  }
</style>
