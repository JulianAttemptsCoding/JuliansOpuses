---
import Base from '../layouts/Base.astro';
import Education from '../components/Education.astro';
import Rich from '../components/Rich.astro';
import { href } from '../lib/url';
import { site } from '../data/site';
import { activities, tools, treat } from '../data/profile';
---

<Base title="About" description="Background, education and activities outside research.">
  <section class="intro wrap">
    <p class="label">About</p>
    <h1>I like finding out how systems work, and whether the numbers actually add up.</h1>
    <div class="lede">
      <p>
        I'm a high-school student, Class of 2027, with a substantial amount of college coursework and research
        behind me. Most of my time goes to research and engineering problems: scientific machine learning,
        simulation, estimation and quantitative modeling.
      </p>
      <p>
        My interests are broad: physics, mathematics, computing, economics and history. What connects the work
        is a habit of taking a messy real system and making it measurable, then checking the result harder
        than the first good-looking metric requires.
      </p>
      <p class="links">
        <a href={href('/#work')}>Selected work →</a>
        <a href={href('/contact/')}>Get in touch →</a>
        {
          site.linkedin && (
            <a class="ext" href={site.linkedin} rel="noopener">LinkedIn</a>
          )
        }
        <a class="ext" href={site.github} rel="noopener">GitHub</a>
      </p>
    </div>
  </section>

  <section class="section wrap ledger" id="education" data-rule>
    <h2 class="label marked ledger-label">Education</h2>
    <Education open />
  </section>

  <section class="section wrap ledger" id="outside" data-rule>
    <h2 class="label marked ledger-label">Outside research</h2>
    <ul class="items">
      {
        activities.map((a) => (
          <li>
            <div class="item-head">
              <h3>
                {a.href ? (
                  <a class="ext quiet" href={a.href} rel="noopener">{a.title}</a>
                ) : (
                  a.title
                )}
              </h3>
              <span class="mono">{a.role}</span>
            </div>
            <p>{a.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section wrap ledger" id="tools" data-rule>
    <h2 class="label marked ledger-label">Tools</h2>
    <div>
      <ul class="tools mono">
        {
          tools.map((t) => (
            <li>
              <a class="quiet" href={t.href} rel="noopener">{t.label}</a>
            </li>
          ))
        }
      </ul>
      <p class="tools-note">The projects show how these get used better than a list does.</p>
    </div>
  </section>

  <!-- Not signposted anywhere else: a small extra for anyone who reads to the end. -->
  <section class="wrap treat-wrap">
    <details class="treat">
      <summary>
        <span class="plus" aria-hidden="true"></span>
        {treat.summary}
      </summary>
      <div class="treat-body">
        <p><Rich parts={treat.body} /></p>
        <p>
          <a class="ext" href={treat.link.href} rel="noopener">{treat.link.label}</a>
        </p>
      </div>
    </details>
  </section>
</Base>

<style>
  .intro {
    padding-top: clamp(3rem, 9vw, 7.5rem);
  }
  h1 {
    max-width: 20ch;
    margin-top: 1.5rem;
    font-size: clamp(2.2rem, 5.6vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .lede {
    display: grid;
    gap: 1.1rem;
    max-width: 62ch;
    margin-top: clamp(2rem, 5vw, 3.5rem);
    margin-left: auto;
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    color: var(--ink);
    font-size: 1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .intro h1,
    :global(html.js) .intro .lede {
      animation: fade-up 0.8s var(--ease) both;
    }
    :global(html.js) .intro .lede {
      animation-delay: 0.15s;
    }
  }

  .section {
    padding-top: clamp(3.5rem, 8vw, 7rem);
  }
  .ledger {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: 1.5rem clamp(1.5rem, 4vw, 4rem);
  }
  .ledger::before {
    content: '';
    grid-column: 1 / -1;
    border-top: 1px solid var(--ink);
  }
  .ledger-label {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
  }

  .items {
    list-style: none;
  }
  .items li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }
  .items li:first-child {
    padding-top: 0;
  }
  .item-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }
  .item-head h3 {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .item-head .mono {
    color: var(--ink-3);
  }
  .items p {
    max-width: 66ch;
    margin-top: 0.45rem;
    color: var(--ink-2);
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 60ch;
    list-style: none;
    font-size: 0.82rem;
  }
  .tools a {
    display: inline-block;
    padding: 0.3em 0.8em;
    border: 1px solid var(--rule);
    border-radius: 999px;
    text-decoration: none;
    transition:
      border-color 0.2s,
      color 0.2s;
  }
  .tools a:hover {
    border-color: var(--accent);
  }
  .tools-note {
    margin-top: 0.9rem;
    color: var(--ink-3);
    font-size: 0.95rem;
  }

  /* The foldout at the very end. */
  .treat-wrap {
    padding-top: clamp(3rem, 7vw, 5.5rem);
  }
  .treat summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--ink-3);
    cursor: pointer;
    transition: color 0.2s;
  }
  .treat summary::-webkit-details-marker {
    display: none;
  }
  .treat summary:hover,
  .treat[open] summary {
    color: var(--ink);
  }
  .plus {
    position: relative;
    flex: none;
    width: 11px;
    height: 11px;
    color: var(--accent-2);
  }
  .plus::before,
  .plus::after {
    content: '';
    position: absolute;
    inset: 5px 0 auto 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }
  .plus::after {
    transform: rotate(90deg);
  }
  .treat[open] .plus::after {
    transform: rotate(0deg);
  }
  .treat-body {
    display: grid;
    gap: 0.75rem;
    max-width: 62ch;
    margin-top: 1rem;
    padding-left: 1rem;
    border-left: 2px solid var(--accent-2);
    color: var(--ink-2);
  }

  @media (max-width: 720px) {
    .ledger {
      grid-template-columns: minmax(0, 1fr);
    }
    .ledger-label {
      position: static;
    }
    .lede {
      margin-left: 0;
    }
  }
</style>
