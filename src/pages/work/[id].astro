---
// One project's write-up. It opens the way a reader needs it to: the title and the
// question, then a plain summary and where the project stands. The facts and figures sit
// beside that in the margin column, and under them a short list of the page's sections
// that stays in view while the write-up scrolls.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Verdict from '../../components/Verdict.astro';
import { href } from '../../lib/url';
import { VERDICTS } from '../../data/verdicts';

export async function getStaticPaths() {
  const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, index: i, total: all.length, next: all[(i + 1) % all.length] },
  }));
}

const { entry, index, total, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = [
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  { slug: 'verdict', text: 'Where it stands' },
];
const num = (n: number) => String(n).padStart(2, '0');
---

<Base title={data.heading ?? data.title} description={data.claim} progress>
  <article class="case wrap">
    <header class="case-head g12">
      <div class="crumbs mono">
        <a href={href('/work/')}>← Projects</a>
        <span>{num(index + 1)} / {num(total)}</span>
      </div>
      <p class="label">{data.domain}</p>
      <h1 style={`view-transition-name: work-${entry.id}`}>{data.heading ?? data.title}</h1>
      <p class="lede">{data.question}</p>
    </header>

    <div class="sheet g12" data-rule>
      <section class="opening" aria-label="Summary">
        <p class="read">{data.summary}</p>
        <div class="status">
          <Verdict status={data.status} />
          <span class="evidence">{data.evidence}</span>
        </div>
        {
          data.links.length > 0 && (
            <ul class="links">
              {data.links.map((l) => {
                // A path on this site (a PDF) opens in its own tab; anything else is a link out.
                const local = l.href.startsWith('/');
                return (
                  <li>
                    <a
                      class:list={{ ext: !local }}
                      href={local ? href(l.href) : l.href}
                      target={local ? '_blank' : undefined}
                      rel="noopener"
                    >
                      {l.label}
                    </a>
                    {l.note && <span class="link-note mono">{l.note}</span>}
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>

      <aside class="rail">
        <p class="claim">{data.claim}</p>
        {
          data.metrics.length > 0 && (
            <dl class="metrics">
              {data.metrics.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd>
                    {m.value}
                    {m.note && <span class="note">{m.note}</span>}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
        {data.context && <p class="context">{data.context}</p>}

        <nav class="toc" aria-label="On this page">
          <p class="label">On this page</p>
          <ol>
            {
              sections.map((s) => (
                <li>
                  <a href={`#${s.slug}`} data-toc={s.slug}>
                    {s.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <div class="body">
        <div class="prose">
          <Content />
        </div>

        <section class="outcome" id="verdict" aria-labelledby="verdict-h">
          <h2 id="verdict-h">Where it stands</h2>
          <p class="outcome-status">
            <span class="stamp" data-reveal="stamp">
              <Verdict status={data.status} />
            </span>
            <span>{VERDICTS[data.status].meaning}</span>
          </p>
          <div class="outcome-cols">
            <div>
              <h3 class="label">What worked</h3>
              <ul class="worked" data-stagger>
                {data.worked.map((item) => <li>{item}</li>)}
              </ul>
            </div>
            <div>
              <h3 class="label">{data.openLabel}</h3>
              <ul class="unresolved" data-stagger>
                {data.open.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </section>

        <a class="next" href={href(`/work/${next.id}/`)}>
          <span class="label">Next</span>
          <span class="next-title" data-reveal="mask-in">{next.data.title}</span>
          <span class="next-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </article>
</Base>

<script>
  // Mark the section being read in the list of the page's sections: the last one whose
  // heading has passed a line a third of the way down the window. Worked out from where
  // the headings are, so it is right after a jump as well as a slow scroll.
  const links = [...document.querySelectorAll<HTMLElement>('[data-toc]')];
  const targets = links
    .map((a) => document.getElementById(a.dataset.toc!))
    .filter((el): el is HTMLElement => el !== null);
  if (targets.length) {
    let queued = false;
    const mark = () => {
      queued = false;
      const line = innerHeight / 3;
      let current: HTMLElement | null = null;
      for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t;
      links.forEach((a) =>
        current && a.dataset.toc === current.id
          ? a.setAttribute('aria-current', 'true')
          : a.removeAttribute('aria-current'),
      );
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(mark);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    mark();
  }

  // A figure, table or code block too wide for the window scrolls sideways inside its
  // own box. While it does, it takes keyboard focus, so it can be scrolled with the arrow
  // keys; while everything fits, it stays out of the tab order.
  const boxes = document.querySelectorAll<HTMLElement>('.prose .frame, .prose .scroll, .prose table, .prose pre');
  const syncScrollers = () =>
    boxes.forEach((box) => {
      // A table keeps its own role and name: it only needs to be reachable.
      const plain = box.tagName !== 'TABLE';
      if (box.scrollWidth > box.clientWidth + 1) {
        box.tabIndex = 0;
        if (plain) {
          box.setAttribute('role', 'group');
          box.setAttribute('aria-label', 'Scrolls sideways');
        }
      } else {
        box.removeAttribute('tabindex');
        if (plain) {
          box.removeAttribute('role');
          box.removeAttribute('aria-label');
        }
      }
    });
  syncScrollers();
  addEventListener('resize', syncScrollers, { passive: true });
  addEventListener('load', syncScrollers);
</script>

<style>
  /* ---------- Opening: where this is, what it is called, and the question it asks ---------- */
  .case-head {
    row-gap: 0;
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
  .crumbs {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    color: var(--ink-3);
  }
  .crumbs a {
    margin-block: -0.3rem;
    padding-block: 0.3rem;
    color: var(--ink);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
  }
  .case-head .label {
    grid-column: 1 / -1;
  }
  h1 {
    grid-column: 1 / -1;
    width: fit-content;
    margin-top: 0.5rem;
    font-size: var(--t-h1);
    line-height: 1.16;
    letter-spacing: -0.02em;
  }
  .case-head .lede {
    margin-top: 1.1rem;
  }

  /* ---------- The page: the write-up in the text columns, its facts beside it ----------
     The same twelve columns as every other page. The write-up takes eight of them, so
     its figures have room, and the margin column takes four. */
  .sheet {
    row-gap: clamp(1rem, 3vw, 2rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  /* The rule under the opening is a thing of its own, so it can draw itself in. */
  .sheet::before {
    content: '';
    grid-column: 1 / -1;
    margin-bottom: 0.5rem;
    border-top: 1px solid var(--ink);
  }
  .opening,
  .body {
    grid-column: 1 / span 8;
    min-width: 0;
  }

  /* What it is, in plain words, and where it stands. */
  .status {
    display: grid;
    grid-template-columns: 8.25rem minmax(0, 1fr);
    align-items: first baseline;
    max-width: var(--measure);
    margin-top: 1.25rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
  }
  .status :global(.verdict) {
    color: var(--ink);
  }
  .evidence {
    max-width: 32rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    margin-top: 1.1rem;
    list-style: none;
    font-size: var(--t-sm);
  }
  .link-note {
    margin-left: 0.5em;
    color: var(--ink-3);
  }

  /* ---------- Margin column: the technical line, the numbers, the sections ---------- */
  .rail {
    grid-column: 9 / -1;
    grid-row: 2 / span 2;
    min-width: 0;
  }
  .claim {
    max-width: 32rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  .metrics {
    margin-top: 1.1rem;
    border-top: 1px solid var(--rule);
  }
  .metrics div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .metrics dt {
    font-size: var(--t-sm);
    color: var(--ink-3);
  }
  .metrics dd {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .note {
    display: block;
    font-size: var(--t-xs);
    color: var(--ink-3);
  }
  .context {
    margin-top: 0.9rem;
    color: var(--ink-3);
    font-size: var(--t-sm);
    line-height: 1.5;
  }
  /* The only thing that stays in view: a short list, never taller than the window. */
  .toc {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    margin-top: 2rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--ink);
  }
  .toc ol {
    margin-top: 0.6rem;
    list-style: none;
    counter-reset: toc;
  }
  .toc a {
    display: flex;
    gap: 0.75rem;
    padding-block: 0.28rem;
    color: var(--ink-3);
    font-size: var(--t-sm);
    text-decoration: none;
    counter-increment: toc;
    transition: color 0.2s;
  }
  .toc a::before {
    content: counter(toc, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    padding-top: 0.15em;
  }
  .toc a:hover,
  .toc a[aria-current] {
    color: var(--ink);
  }
  .toc a[aria-current]::before {
    color: var(--accent);
  }

  /* ---------- Body: the evidence ---------- */
  /* A section's heading is a clear step above the text, so the page can be scanned by
     its headings. */
  .prose :global(h2),
  .outcome h2 {
    margin-top: clamp(2.75rem, 5vw, 3.75rem);
    font-size: var(--t-h2);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 43.75em) {
    @supports (animation-timeline: view()) {
      .prose :global(h2),
      .outcome h2 {
        animation: unmask linear both;
        animation-timeline: view(block var(--header-h) 0px);
        animation-range: entry 10px entry 110px;
      }
    }
  }
  .prose :global(h2:first-child) {
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }
  .prose :global(h3) {
    margin-top: 2rem;
    font-size: var(--t-lg);
    letter-spacing: -0.01em;
  }
  /* Figures style their own content: :not(figure *) keeps the prose rules, and the
     page's theme colours, off the light figure surface. */
  .prose :global(:is(p, ul, ol):not(figure *)) {
    max-width: var(--measure);
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--t-lg);
    line-height: 1.6;
  }
  /* Links out of the site carry the same arrow as everywhere else. */
  .prose :global(a[href^='http']:not(figure *))::after {
    content: '\2060\202f\2197';
    font-family: var(--font-mono);
    font-size: 0.85em;
  }
  .prose :global(strong:not(figure *)) {
    color: var(--ink);
    font-weight: 600;
  }
  .prose :global(:is(ul, ol):not(figure *)) {
    padding-left: 1.2rem;
  }
  .prose :global(li:not(figure *) + li) {
    margin-top: 0.4rem;
  }
  .prose :global(li:not(figure *)::marker) {
    color: var(--ink-3);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.86em;
    padding: 0.1em 0.35em;
    background: var(--paper-2);
    border-radius: 4px;
  }
  .prose :global(pre) {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--paper-2) !important;
    color: var(--ink) !important;
    border-radius: 3px;
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
    font-size: inherit;
  }
  .prose :global(pre span) {
    color: inherit !important;
  }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    margin-top: 1.5rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem 1.25rem 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }
  .prose :global(th) {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--ink-3);
    border-bottom-color: var(--ink);
  }

  /* ---------- Where it stands ---------- */
  .outcome-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    margin-top: 1.25rem;
    color: var(--ink-2);
  }
  .outcome-status :global(.verdict) {
    color: var(--ink);
  }
  .stamp {
    display: inline-block;
    transform-origin: center;
  }
  /* The meaning is written out beside this one, so it needs no explanation on hover. */
  .stamp :global(.tip) {
    display: none;
  }
  .stamp :global(.verdict) {
    cursor: default;
  }
  .outcome-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem clamp(1.5rem, 4vw, 2.5rem);
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }
  .outcome ul {
    list-style: none;
    margin-top: 0.9rem;
  }
  .outcome li {
    position: relative;
    padding: 0.7rem 0 0.7rem 1.5rem;
    border-bottom: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: var(--t-md);
    line-height: 1.5;
  }
  .outcome li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
  }
  .worked li::before {
    background: var(--ink);
  }

  /* ---------- Next project ---------- */
  .next {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.5rem 1rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
    text-decoration: none;
  }
  .next .label {
    grid-column: 1 / -1;
  }
  .next-title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 500;
  }
  .next-arrow {
    font-size: 1.25rem;
    line-height: 1.2;
    transition: transform 0.45s var(--ease);
  }
  .next:hover .next-arrow {
    transform: translateX(0.5rem);
  }

  /* One column: the summary, then the facts, then the write-up. The list of sections is
     left out: nothing is beside the text for it to stay in view in. */
  @media (max-width: 56.25em) {
    .opening,
    .body,
    .rail {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .rail {
      max-width: 34rem;
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 37.5em) {
    .status {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
    .outcome-cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
