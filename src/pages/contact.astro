---
import Base from '../layouts/Base.astro';
import { site, contact } from '../data/site';

const dev = import.meta.env.DEV;
const connected = contact.accessKey !== '';
// Without an access key the form cannot deliver anything, so production leaves it out.
const showForm = connected || dev;
---

<Base title="Contact" description="Send Julian Juan a message about research, projects or opportunities." cta={false}>
  <section class="page-intro wrap g12">
    <h1>{showForm ? 'Send me a message.' : 'Get in touch.'}</h1>
    <p class="lede">
      Questions about a project, research, an internship or working together are welcome. So are corrections.
    </p>
  </section>

  <section class="wrap">
    <div class:list={['g12', 'sheet', { solo: !showForm }]}>

    {
      showForm && (
        <div class="panel">
          {!connected && (
            <p class="setup mono">
              Dev only: the form is not connected yet. Add a Web3Forms access key to <code>contact.accessKey</code>{' '}
              in src/data/site.ts. Until then it validates but does not send, and production hides it.
            </p>
          )}

          {/* With scripts the handler below sends this and stays on the page. Without them
              the browser posts the same fields to the same service, which shows its own
              confirmation. */}
          <form
            class="form"
            action={connected ? contact.endpoint : undefined}
            method="post"
            data-contact-form
            data-endpoint={contact.endpoint}
            data-key={contact.accessKey}
            novalidate
          >
            {connected && <input type="hidden" name="access_key" value={contact.accessKey} />}
            <input type="hidden" name="subject" value="Portfolio message" />
            <input type="hidden" name="from_name" value="Portfolio contact form" />
            <div class="field">
              <label for="cf-name">Name</label>
              <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" />
              <p class="error" data-error-for="name" hidden>Please add your name.</p>
            </div>
            <div class="field">
              <label for="cf-email">Email</label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                maxlength="254"
                spellcheck="false"
              />
              <p class="error" data-error-for="email" hidden>Please add an email address I can reply to.</p>
            </div>
            <div class="field">
              <label for="cf-message">Message</label>
              <textarea id="cf-message" name="message" rows="7" required minlength="10" maxlength="5000"></textarea>
              <p class="error" data-error-for="message" hidden>Please write a message of at least 10 characters.</p>
            </div>

            {/* Honeypot: hidden from people, filled in by most spam bots. */}
            <div class="hp" aria-hidden="true">
              <label for="cf-company">Leave this field empty</label>
              <input id="cf-company" name="botcheck" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="actions">
              <button class="send" type="submit" data-submit data-magnetic>
                <span data-submit-label>Send message</span>
                <span class="send-arrow" aria-hidden="true">
                  →
                </span>
              </button>
              <p class="status" data-status role="status" aria-live="polite" />
            </div>
          </form>

          <div class="done" data-done hidden tabindex="-1">
            <h2>Thanks, I’ve got it.</h2>
            <p>I’ll reply from my own email address.</p>
            <button class="again" type="button" data-again>
              Send another message
            </button>
          </div>
        </div>
      )
    }
      <div class="beside">
        {showForm && <p class="how">This goes to my inbox. I only use your email address to reply.</p>}
        <div class="elsewhere">
          <h2 class="label">{showForm ? 'Elsewhere' : 'Reach me on'}</h2>
          <ul class="routes">
            {
              site.linkedin && (
                <li>
                  <a class="ext" href={site.linkedin} rel="noopener">
                    LinkedIn
                  </a>
                  <span class="note">Direct messages</span>
                </li>
              )
            }
            <li>
              <a class="ext" href={site.github} rel="noopener">GitHub</a>
              <span class="note">Code and project history</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  if (form) {
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const again = document.querySelector<HTMLButtonElement>('[data-again]')!;
    const fields = ['name', 'email', 'message'] as const;
    type Field = (typeof fields)[number];
    const control = (name: Field) => form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
    const errorFor = (name: Field) => form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;

    const check = (name: Field): boolean => {
      const el = control(name);
      el.value = el.value.trim() === '' ? '' : el.value;
      // minlength is only enforced natively after typing, so the length is checked here too.
      const ok = el.checkValidity() && el.value.trim().length >= Math.max(1, el.minLength);
      errorFor(name).hidden = ok;
      el.setAttribute('aria-invalid', String(!ok));
      if (ok) el.removeAttribute('aria-describedby');
      else el.setAttribute('aria-describedby', errorFor(name).id);
      return ok;
    };

    fields.forEach((name) => {
      const el = control(name);
      errorFor(name).id = `cf-${name}-error`;
      // Only start correcting a field once it has been left invalid.
      el.addEventListener('blur', () => {
        if (el.value !== '' || el.getAttribute('aria-invalid') === 'true') check(name);
      });
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') check(name);
      });
    });

    const setBusy = (busy: boolean) => {
      submit.disabled = busy;
      submitLabel.textContent = busy ? 'Sending…' : 'Send message';
    };
    const say = (text: string, isError = false) => {
      status.textContent = text;
      status.classList.toggle('is-error', isError);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      say('');
      const results = fields.map(check);
      const firstBad = fields[results.indexOf(false)];
      if (firstBad) {
        control(firstBad).focus();
        return;
      }
      const data = new FormData(form);
      // A filled honeypot means a bot: pretend it worked and send nothing.
      const isBot = String(data.get('botcheck') ?? '') !== '';
      const key = form.dataset.key ?? '';
      if (!key && !isBot) {
        say('Preview only: add the access key in src/data/site.ts to send messages.', true);
        return;
      }

      setBusy(true);
      try {
        if (!isBot) {
          const name = String(data.get('name')).trim();
          const res = await fetch(form.dataset.endpoint!, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: key,
              subject: `Portfolio message from ${name}`,
              from_name: 'Portfolio contact form',
              name,
              email: String(data.get('email')).trim(),
              message: String(data.get('message')).trim(),
            }),
          });
          const body = (await res.json().catch(() => null)) as { success?: boolean } | null;
          if (!res.ok || !body?.success) throw new Error(`Form service answered ${res.status}`);
        }
        form.hidden = true;
        done.hidden = false;
        done.focus();
        form.reset();
      } catch {
        say('That did not send. Check your connection and try again, or message me on LinkedIn.', true);
      } finally {
        setBusy(false);
      }
    });

    again.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      say('');
      control('name').focus();
    });
  }
</script>

<style>
  /* The same two parts as every other page, under the same rule a section opens with:
     the form in the text columns, and the other ways to reach me beside it. */
  .sheet {
    row-gap: 2.5rem;
    align-items: start;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--ink);
  }
  .panel {
    grid-column: 1 / span 7;
  }
  .beside {
    grid-column: 8 / -1;
  }
  /* Without the form, the other ways to reach me take its place. */
  .sheet.solo .beside {
    grid-column: 1 / span 7;
  }
  .how {
    max-width: 40ch;
    margin-bottom: 1.5rem;
    color: var(--ink-2);
    font-size: var(--t-sm);
  }
  .routes {
    margin-top: 0.75rem;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .routes li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1.5rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--rule);
  }
  .routes a {
    padding-block: 0.1rem;
    font-size: var(--t-sm);
    text-decoration: none;
  }
  .routes .note {
    color: var(--ink-3);
    font-size: var(--t-sm);
  }

  .panel {
    min-width: 0;
  }
  .setup {
    margin-bottom: 1.5rem;
    padding: 0.85rem 1rem;
    border: 1px dashed var(--ink-3);
    border-radius: 3px;
    color: var(--ink-2);
    line-height: 1.6;
  }
  .setup code {
    color: var(--accent);
  }
  /* Name and email share a line where there is room; the message runs under both. */
  .form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1.4rem var(--col-gap);
  }
  .field:has(textarea),
  .actions {
    grid-column: 1 / -1;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  label {
    font-size: var(--t-sm);
    font-weight: 500;
    color: var(--ink-2);
  }
  input,
  textarea {
    width: 100%;
    padding: 0.6rem 0.8rem;
    /* The edge is what says "this is a field", so it is drawn in a readable grey. */
    border: 1px solid var(--ink-3);
    border-radius: 3px;
    background: var(--paper-2);
    color: var(--ink);
    font: inherit;
    line-height: 1.5;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }
  textarea {
    min-height: 9.5rem;
    resize: vertical;
  }
  input:hover,
  textarea:hover {
    border-color: var(--ink);
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: transparent;
    border-radius: 3px;
    background: var(--paper);
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: var(--accent);
  }
  .error {
    color: var(--accent);
    font-size: 0.88rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.5rem;
  }
  .send,
  .again {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    padding: 0.7em 1.25em;
    font-size: var(--t-sm);
    font-weight: 500;
    border: 1px solid var(--ink);
    border-radius: 3px;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .send:hover:not(:disabled) {
    background: var(--accent-fill);
    border-color: var(--accent-fill);
    color: var(--on-accent);
  }
  .send:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .send-arrow {
    transition: transform 0.35s var(--ease);
  }
  .send:hover:not(:disabled) .send-arrow {
    transform: translateX(0.3rem);
  }
  .status {
    flex: 1 1 14rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .status.is-error {
    color: var(--accent);
  }

  .done {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--ink);
    border-radius: 3px;
  }
  .done:focus-visible {
    outline-offset: 4px;
    border-radius: 3px;
  }
  .done h2 {
    font-size: var(--t-h3);
  }
  .done p:not(.label) {
    max-width: 44ch;
    margin-top: 0.75rem;
    color: var(--ink-2);
  }
  .again {
    margin-top: 1.5rem;
    background: none;
    color: var(--ink);
  }
  .again:hover {
    background: var(--ink);
    color: var(--paper);
  }

  /* One column: the form, then the other ways to reach me. */
  @media (max-width: 900px) {
    .panel,
    .beside,
    .sheet.solo .beside {
      grid-column: 1 / -1;
    }
    .beside {
      max-width: 34rem;
    }
  }
</style>
