---
// The serif is loaded with its optical-size axis, so headings get the display cut.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { href } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Show the footer's large contact call to action. */
  cta?: boolean;
  /** Show a reading-progress line under the header (case studies). */
  progress?: boolean;
  /** The page's sections, by element id, for the column of ticks in the right gutter. */
  sections?: { id: string; label: string }[];
}
const {
  title,
  description = site.description,
  cta = true,
  progress = false,
  sections = [],
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The card shown when a link to the site is shared.
const preview = new URL(href('/og.png'), Astro.site);
// Who the site is about, in the form search engines read. Only on the home page.
const isHome = Astro.url.pathname === href('/');
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL(href('/'), Astro.site).href,
  description: site.description,
  sameAs: [site.github, site.linkedin].filter(Boolean),
};

// The home page, when it is the first page of a visit, opens on a dark screen that runs
// through what the site covers, one phrase at a time, and ends on the name. Every phrase
// is something that has a page or a section here. The timings live in one place: a beat
// of dark screen while the page arrives, the phrases at a quick steady pace, the name
// held, then the curtain lifts.
const introWords = [
  'Particle physics',
  'Detector simulation',
  'Machine learning',
  'Math modeling',
  'Web security',
  'Hardware',
  'School budgets',
  'Hackathons',
];
const INTRO_LEAD = 0.25; // seconds before the first phrase
const INTRO_WORD = 0.24; // seconds each phrase is shown
const INTRO_HOLD = 0.9; // seconds from the name appearing to the curtain starting to lift
const INTRO_LIFT = 0.7; // seconds the curtain takes
const introName = INTRO_LEAD + introWords.length * INTRO_WORD;
const introOut = introName + INTRO_HOLD;
const introTiming = `--intro-lead:${INTRO_LEAD}s;--intro-word:${INTRO_WORD}s;--intro-name:${introName.toFixed(2)}s;--intro-out:${introOut.toFixed(2)}s;--intro-lift:${INTRO_LIFT}s`;
const introMs = Math.round((introOut + INTRO_LIFT) * 1000);
---

<!doctype html>
<html lang="en" style={introTiming} data-opening={isHome ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="sitemap" href={href('/sitemap.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Julian Juan, a senior at Los Gatos High School who does physics research, builds software and hardware, and models problems mathematically." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2f0e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#181b1f" media="(prefers-color-scheme: dark)" />
    {isHome && <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />}
    <script is:inline>
      // Runs before first paint: mark that scripts work, apply a saved theme and a saved
      // "paused" choice, and decide whether the intro plays.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') d.dataset.theme = t;
          if (localStorage.getItem('motion') === 'paused') d.dataset.motion = 'paused';
        } catch (e) {}
        // The intro plays once, at the very beginning: on the home page, when it is the
        // first page of the visit. Any other page (a link someone was sent, a page opened
        // in a new tab from this site) never shows it, and marks the visit as begun, so
        // going to the home page afterwards does not show it either.
        try {
          var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var begun = sessionStorage.getItem('intro');
          var fromHere = document.referrer && new URL(document.referrer).origin === location.origin;
          if (!calm && !begun && !fromHere && d.hasAttribute('data-opening')) d.classList.add('intro');
          sessionStorage.setItem('intro', '1');
        } catch (e) {}
      })();
    </script>
  </head>
  <body id="top">
    <!-- The intro, on the home page only: what the site covers, a phrase at a time, then
         the name, then the curtain lifts. It only appears when the inline script above
         adds `intro`, so it never blocks a reader without JavaScript or one who prefers
         reduced motion. -->
    {
      isHome && (
        <div class="intro-screen" aria-hidden="true" data-intro={introMs}>
          <div class="intro-stack">
            {introWords.map((w, i) => (
              <span class="intro-word" style={`--k:${i}`}>
                {w}
              </span>
            ))}
            <span class="intro-name">{site.name}</span>
          </div>
          <span class="intro-skip">
            <span class="by-click">Click</span>
            <span class="by-tap">Tap</span> to skip
          </span>
        </div>
      )
    }

    <a class="skip" href="#main">Skip to content</a>
    <Header progress={progress} />
    <main id="main">
      {
        sections.length > 0 && (
          <div class="ticks-anchor">
            <nav class="ticks" aria-label="Sections of this page">
              <ol>
                {sections.map((s) => (
                  <li>
                    <a href={`#${s.id}`} data-tick={s.id}>
                      <span class="ticks-name">{s.label}</span>
                      <span class="ticks-mark" />
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        )
      }
      <slot />
    </main>
    <Footer cta={cta} />
  </body>
</html>

<script>
  const root = document.documentElement;
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

  // ---- Intro: unlock the page when the curtain has lifted, or at once if skipped. ----
  const intro = document.querySelector<HTMLElement>('[data-intro]');
  const introRunning = !!intro && root.classList.contains('intro');
  /** Resolves when the intro is out of the way (immediately if there is none). */
  const introDone = new Promise<void>((resolve) => {
    if (!introRunning) return resolve();
    const done = () => {
      root.classList.add('intro-done');
      resolve();
    };
    intro!.addEventListener('animationend', (e) => {
      if (e.animationName.includes('intro-lift')) done();
    });
    // Any key, click or turn of the wheel skips it, and the page's own entrance then
    // starts at once.
    const skip = () => {
      if (!root.classList.contains('intro-done')) root.classList.add('intro-skipped');
      done();
    };
    addEventListener('keydown', skip, { once: true });
    addEventListener('pointerdown', skip, { once: true });
    addEventListener('wheel', skip, { once: true, passive: true });
    // A backstop in case the animation never runs: the intro's own length, and a little.
    setTimeout(done, Number(intro!.dataset.intro) + 500);
  });

  // ---- Page-to-page transitions: a link to something that cannot take part (the résumé
  // PDF, another site on this host) ends the transition early. That is expected, so the
  // rejection is absorbed here instead of surfacing as an error.
  addEventListener('pageswap', (e) => {
    const vt = (e as Event & { viewTransition?: ViewTransition | null }).viewTransition;
    vt?.ready.catch(() => {});
    vt?.finished.catch(() => {});
  });

  // ---- Smooth wheel scrolling (mouse and trackpad only; touch keeps its native feel). ----
  // The scroll-driven reveals follow the scroll position exactly, so easing the wheel is
  // what makes them glide instead of stepping. It is still the page's own scroll.
  if (fine && !calm) {
    import('lenis').then(({ default: Lenis }) => {
      // In-page links are eased too; the page's own scroll-padding keeps them clear of the header.
      const lenis = new Lenis({ lerp: 0.11, anchors: true, autoRaf: true });
      if (introRunning) {
        lenis.stop();
        introDone.then(() => lenis.start());
      }
    });
  }

  // ---- Pause: one switch for everything that moves on its own (the detector drawing,
  // the band of fields, the live dots). Any [data-pause] button flips it, and the choice
  // is remembered.
  const pauses = document.querySelectorAll<HTMLButtonElement>('[data-pause]');
  const showPaused = () => {
    const paused = root.dataset.motion === 'paused';
    pauses.forEach((b) => {
      b.textContent = paused ? 'Play' : 'Pause';
      b.setAttribute('aria-label', paused ? 'Play the animations' : 'Pause the animations');
    });
  };
  showPaused();
  pauses.forEach((b) =>
    b.addEventListener('click', () => {
      const paused = root.dataset.motion !== 'paused';
      if (paused) root.dataset.motion = 'paused';
      else delete root.dataset.motion;
      try {
        localStorage.setItem('motion', paused ? 'paused' : 'playing');
      } catch {
        /* the choice still holds for this page */
      }
      showPaused();
    }),
  );

  // ---- The section being read: its marker fills, and its tick in the gutter lengthens. ----
  // A section is "being read" while it crosses a thin band a little above the middle of
  // the window, so exactly one is current at a time.
  const marked = document.querySelectorAll<HTMLElement>('main section[id]:has(.marked)');
  if (marked.length && 'IntersectionObserver' in window) {
    const ticks = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-tick]').forEach((a) => ticks.set(a.dataset.tick!, a));
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          el.toggleAttribute('data-current', entry.isIntersecting);
          const tick = ticks.get(el.id);
          if (entry.isIntersecting) tick?.setAttribute('aria-current', 'location');
          else tick?.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-38% 0px -60% 0px' },
    );
    marked.forEach((s) => spy.observe(s));
  }

  // ---- Numbers count up, slowly enough to watch, once they are well inside the window. ----
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  if (counters.length && !calm && 'IntersectionObserver' in window) {
    const DURATION = 2200;
    const plans = new Map<Element, { pre: string; target: number; post: string }>();
    counters.forEach((el) => {
      // Only plain quantities count up: "$88M" does, a range like "9th–10th" stays as written.
      const m = el.textContent!.trim().match(/^([$€£~]?)(\d+)([A-Za-z%+]{0,3})$/);
      if (!m) return;
      plans.set(el, { pre: m[1], target: Number(m[2]), post: m[3] });
      // Hold the width of the final value so nothing shifts while it counts.
      el.style.minWidth = `${el.getBoundingClientRect().width}px`;
      el.style.display = 'inline-block';
      el.textContent = `${m[1]}0${m[3]}`;
    });
    const running = new Map<Element, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target as HTMLElement;
          const plan = plans.get(el);
          if (!plan || !entry.isIntersecting || running.has(el)) continue;
          const t0 = performance.now();
          const step = (now: number) => {
            const t = Math.min(1, (now - t0) / DURATION);
            // A steady climb that eases onto the value, rather than a rush to it.
            const eased = 1 - (1 - t) ** 2;
            el.textContent = `${plan.pre}${Math.round(plan.target * eased)}${plan.post}`;
            if (t < 1) running.set(el, requestAnimationFrame(step));
          };
          running.set(el, requestAnimationFrame(step));
        }
      },
      // Start only once the number has cleared the bottom quarter of the window.
      { threshold: 1, rootMargin: '0px 0px -25% 0px' },
    );
    // Once a number has left the window entirely it goes back to zero, so it counts
    // again the next time it is scrolled to.
    const reset = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) continue;
        const plan = plans.get(entry.target);
        if (!plan) continue;
        cancelAnimationFrame(running.get(entry.target) ?? 0);
        running.delete(entry.target);
        entry.target.textContent = `${plan.pre}0${plan.post}`;
      }
    });
    introDone.then(() =>
      plans.forEach((_, el) => {
        io.observe(el);
        reset.observe(el);
      }),
    );
  }

  // ---- Magnetic buttons: lean toward the pointer, spring back when it leaves. ----
  if (fine && !calm) {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      el.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const dx = e.clientX - (r.left + r.width / 2);
        const dy = e.clientY - (r.top + r.height / 2);
        el.style.transform = `translate(${(dx * 0.22).toFixed(1)}px, ${(dy * 0.32).toFixed(1)}px)`;
      });
      el.addEventListener('pointerleave', () => {
        el.style.transform = '';
      });
    });
  }

  // ---- Local time in the footer, so a reader knows when a reply is likely. ----
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-US', {
      hour: 'numeric',
      minute: '2-digit',
      timeZone: 'America/Los_Angeles',
      timeZoneName: 'short',
    });
    const tick = () => {
      const parts = fmt.formatToParts(new Date());
      const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
      clock.textContent = `${get('hour')}:${get('minute')} ${get('dayPeriod')} ${get('timeZoneName')}`;
    };
    tick();
    setInterval(tick, 15_000);
  }
</script>

<style is:global>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    z-index: 100;
    padding: 0.6rem 1rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 0 0 8px 8px;
  }
  .skip:focus {
    top: 0;
  }

  /* ---------- Intro ---------- */
  .intro-screen {
    display: none;
  }
  html.intro:not(.intro-done) {
    overflow: hidden;
  }
  html.intro:not(.intro-done) .intro-screen {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: var(--footer-bg);
    color: var(--footer-ink);
    animation: intro-lift var(--intro-lift) var(--ease-inout) var(--intro-out) forwards;
  }
  /* The curtain's lower edge is an arc that flattens as it rises. */
  html.intro:not(.intro-done) .intro-screen::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -15%;
    width: 130%;
    height: 22vh;
    margin-top: -1px;
    background: inherit;
    border-radius: 0 0 50% 50% / 0 0 100% 100%;
    animation: intro-arc var(--intro-lift) var(--ease-inout) var(--intro-out) forwards;
  }
  .intro-stack {
    position: relative;
    display: grid;
    place-items: center;
  }
  .intro-stack > * {
    grid-area: 1 / 1;
    opacity: 0;
  }
  /* Each phrase arrives from just below, stands still for most of its turn, and leaves
     upward as the next one arrives. */
  .intro-word {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.5rem);
    letter-spacing: -0.012em;
    color: var(--footer-ink-2);
    white-space: nowrap;
    animation: intro-word var(--intro-word) linear calc(var(--intro-lead) + var(--k) * var(--intro-word)) both;
  }
  .intro-name {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 6vw, 4.6rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
    animation: intro-name 0.4s var(--ease) var(--intro-name) forwards;
  }
  /* How to get past it, said quietly once it is clear the screen is going to stay a while. */
  .intro-skip {
    position: absolute;
    inset: auto 0 clamp(1.5rem, 5vh, 3rem) 0;
    text-align: center;
    font-size: var(--t-xs);
    letter-spacing: 0.02em;
    color: var(--footer-ink-2);
    opacity: 0;
    animation: intro-hint 0.5s ease 0.9s forwards;
  }
  .by-tap {
    display: none;
  }
  @media (hover: none) {
    .by-click {
      display: none;
    }
    .by-tap {
      display: inline;
    }
  }
  @keyframes intro-word {
    0% {
      opacity: 0;
      transform: translateY(0.3em);
    }
    15% {
      opacity: 1;
      transform: none;
    }
    87% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: translateY(-0.22em);
    }
  }
  @keyframes intro-hint {
    to {
      opacity: 0.75;
    }
  }
  @keyframes intro-name {
    from {
      opacity: 0;
      transform: translateY(0.3em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes intro-lift {
    to {
      transform: translateY(-125%);
    }
  }
  @keyframes intro-arc {
    to {
      height: 0;
    }
  }
</style>
